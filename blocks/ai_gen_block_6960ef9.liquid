{% doc %}
  @prompt
    AI generated
    
    
    generate a comparison snapshot table to show the following text:  | Feature          | UltiScrape | UltiWipe | Hybrid |
    | ---------------- | ---------- | -------- | ------ |
    | Dirt scraping    | ★★★★★      | ★★       | ★★★★   |
    | Water absorption | ★          | ★★★★★    | ★★★    |
    | Daily usability  | ★★★★       | ★★★★     | ★★★★★  |
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-comparison-table__wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
  }

  .ai-comparison-table__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-comparison-table__table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    border-spacing: 0;
  }

  .ai-comparison-table__table-{{ ai_gen_id }} th,
  .ai-comparison-table__table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.cell_alignment }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table__table-{{ ai_gen_id }} thead th {
    background-color: {{ block.settings.header_bg_color }};
    color: {{ block.settings.header_text_color }};
    font-size: {{ block.settings.header_font_size }}px;
    font-weight: 700;
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table__table-{{ ai_gen_id }} tbody td {
    background-color: {{ block.settings.row_bg_color }};
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.body_font_size }}px;
  }

  .ai-comparison-table__table-{{ ai_gen_id }} tbody tr:nth-child(even) td {
    background-color: {{ block.settings.row_alt_bg_color }};
  }

  .ai-comparison-table__table-{{ ai_gen_id }} tbody tr:last-child td {
    border-bottom: none;
  }

  .ai-comparison-table__star-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: {{ block.settings.star_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table__table-{{ ai_gen_id }} th,
    .ai-comparison-table__table-{{ ai_gen_id }} td {
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
      font-size: {{ block.settings.body_font_size | times: 0.9 }}px;
    }

    .ai-comparison-table__table-{{ ai_gen_id }} thead th {
      font-size: {{ block.settings.header_font_size | times: 0.9 }}px;
    }

    .ai-comparison-table__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-table__wrapper-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-comparison-table__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <table class="ai-comparison-table__table-{{ ai_gen_id }}">
      <thead>
        <tr>
          <th>{{ block.settings.col_1_header }}</th>
          <th>{{ block.settings.col_2_header }}</th>
          <th>{{ block.settings.col_3_header }}</th>
          <th>{{ block.settings.col_4_header }}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{{ block.settings.row_1_label }}</td>
          <td>
            <span class="ai-comparison-table__star-{{ ai_gen_id }}">
              {% for i in (1..block.settings.row_1_col_2_stars) %}★{% endfor %}
            </span>
          </td>
          <td>
            <span class="ai-comparison-table__star-{{ ai_gen_id }}">
              {% for i in (1..block.settings.row_1_col_3_stars) %}★{% endfor %}
            </span>
          </td>
          <td>
            <span class="ai-comparison-table__star-{{ ai_gen_id }}">
              {% for i in (1..block.settings.row_1_col_4_stars) %}★{% endfor %}
            </span>
          </td>
        </tr>
        <tr>
          <td>{{ block.settings.row_2_label }}</td>
          <td>
            <span class="ai-comparison-table__star-{{ ai_gen_id }}">
              {% for i in (1..block.settings.row_2_col_2_stars) %}★{% endfor %}
            </span>
          </td>
          <td>
            <span class="ai-comparison-table__star-{{ ai_gen_id }}">
              {% for i in (1..block.settings.row_2_col_3_stars) %}★{% endfor %}
            </span>
          </td>
          <td>
            <span class="ai-comparison-table__star-{{ ai_gen_id }}">
              {% for i in (1..block.settings.row_2_col_4_stars) %}★{% endfor %}
            </span>
          </td>
        </tr>
        <tr>
          <td>{{ block.settings.row_3_label }}</td>
          <td>
            <span class="ai-comparison-table__star-{{ ai_gen_id }}">
              {% for i in (1..block.settings.row_3_col_2_stars) %}★{% endfor %}
            </span>
          </td>
          <td>
            <span class="ai-comparison-table__star-{{ ai_gen_id }}">
              {% for i in (1..block.settings.row_3_col_3_stars) %}★{% endfor %}
            </span>
          </td>
          <td>
            <span class="ai-comparison-table__star-{{ ai_gen_id }}">
              {% for i in (1..block.settings.row_3_col_4_stars) %}★{% endfor %}
            </span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

