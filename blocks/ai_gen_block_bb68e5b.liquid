        },
        {
          "value": "georgia",
          "label": "Georgia"
        },
        {
          "value": "times",
          "label": "Times New Roman"
        },
        {
          "value": "courier",
          "label": "Courier New"
        },
        {
          "value": "verdana",
          "label": "Verdana"
        },
        {
          "value": "trebuchet",
          "label": "Trebuchet MS"
        },
        {
          "value": "playfair",
          "label": "Playfair Display (Google)"
        },
        {
          "value": "montserrat",
          "label": "Montserrat (Google)"
        },
        {
          "value": "roboto",
          "label": "Roboto (Google)"
        },
        {
          "value": "opensans",
          "label": "Open Sans (Google)"
        },
        {
          "value": "lato",
          "label": "Lato (Google)"
        },
        {
          "value": "raleway",
          "label": "Raleway (Google)"
        },
        {
          "value": "poppins",
          "label": "Poppins (Google)"
        },
        {
          "value": "merriweather",
