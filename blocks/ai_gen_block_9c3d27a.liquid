{% doc %}
  @prompt
    create customer reviews block with Gold Stars (Centred on top), followed by Review Heading, then Review Text and lastly, Customer Name and Location in Italics. There should be 4 cards horizotontally displayed for both mobile and non-mobile devices and a slider to see more cards. Each card should have a light grey background and a 20pc spacing between each card, Add top and bottom spacing of 20px to the block, Increase top spacing to 50px
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-container-{{ ai_gen_id }} {
    padding: 50px 0 20px;
    width: 100%;
    display: block;
  }

  .ai-reviews-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .ai-reviews-slider-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 20px;
  }

  .ai-reviews-slider-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-review-card-{{ ai_gen_id }} {
    flex: 0 0 calc(25% - 15px);
    min-width: 250px;
    background-color: {{ block.settings.card_background }};
    padding: 30px 20px;
    border-radius: {{ block.settings.card_border_radius }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }

  .ai-review-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    justify-content: center;
  }

  .ai-review-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
  }

  .ai-review-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-review-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-review-customer-{{ ai_gen_id }} {
    font-size: {{ block.settings.customer_size }}px;
    color: {{ block.settings.customer_color }};
    font-style: italic;
    margin: 0;
  }

  .ai-reviews-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
    padding: 0 20px;
  }

  .ai-reviews-nav-button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_bg }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-reviews-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg }};
    color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-reviews-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-reviews-nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 989px) {
    .ai-review-card-{{ ai_gen_id }} {
      flex: 0 0 calc(25% - 15px);
      min-width: 220px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-review-card-{{ ai_gen_id }} {
      flex: 0 0 calc(25% - 15px);
      min-width: 200px;
    }
  }
{% endstyle %}

<customer-reviews-{{ ai_gen_id }} class="ai-reviews-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-reviews-wrapper-{{ ai_gen_id }}">
    <div class="ai-reviews-slider-{{ ai_gen_id }}" data-slider>
      {% for i in (1..8) %}
        {% liquid
          assign review_enabled_key = 'review_' | append: i | append: '_enabled'
          assign review_rating_key = 'review_' | append: i | append: '_rating'
          assign review_heading_key = 'review_' | append: i | append: '_heading'
          assign review_text_key = 'review_' | append: i | append: '_text'
          assign review_customer_key = 'review_' | append: i | append: '_customer'
          assign review_location_key = 'review_' | append: i | append: '_location'

          assign review_enabled = block.settings[review_enabled_key]
          assign review_rating = block.settings[review_rating_key]
          assign review_heading = block.settings[review_heading_key]
          assign review_text = block.settings[review_text_key]
          assign review_customer = block.settings[review_customer_key]
          assign review_location = block.settings[review_location_key]
        %}

        {% if review_enabled %}
          <div class="ai-review-card-{{ ai_gen_id }}">
            <div class="ai-review-stars-{{ ai_gen_id }}">
              {% for star in (1..5) %}
                <svg class="ai-review-star-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="{% if star <= review_rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              {% endfor %}
            </div>

            {% if review_heading != blank %}
              <h3 class="ai-review-heading-{{ ai_gen_id }}">{{ review_heading }}</h3>
            {% endif %}

            {% if review_text != blank %}
              <p class="ai-review-text-{{ ai_gen_id }}">{{ review_text }}</p>
            {% endif %}

            {% if review_customer != blank or review_location != blank %}
              <p class="ai-review-customer-{{ ai_gen_id }}">
                {% if review_customer != blank %}{{ review_customer }}{% endif %}{% if review_customer != blank and review_location != blank %}, {% endif %}{% if review_location != blank %}{{ review_location }}{% endif %}
              </p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-reviews-nav-{{ ai_gen_id }}">
      <button class="ai-reviews-nav-button-{{ ai_gen_id }}" data-prev aria-label="Previous reviews">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button class="ai-reviews-nav-button-{{ ai_gen_id }}" data-next aria-label="Next reviews">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</customer-reviews-{{ ai_gen_id }}>

<script>
  (function() {
    class CustomerReviews{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.slider = this.querySelector('[data-slider]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
      }

      connectedCallback() {
        this.setupNavigation();
        this.updateButtonStates();
        this.slider.addEventListener('scroll', () => this.updateButtonStates());
      }

      setupNavigation() {
        this.prevButton.addEventListener('click', () => this.scroll('prev'));
        this.nextButton.addEventListener('click', () => this.scroll('next'));
      }

      scroll(direction) {
        const scrollAmount = this.slider.offsetWidth * 0.8;
        const currentScroll = this.slider.scrollLeft;
        
        if (direction === 'next') {
          this.slider.scrollLeft = currentScroll + scrollAmount;
        } else {
          this.slider.scrollLeft = currentScroll - scrollAmount;
        }
      }

      updateButtonStates() {
        const isAtStart = this.slider.scrollLeft <= 0;
        const isAtEnd = this.slider.scrollLeft + this.slider.offsetWidth >= this.slider.scrollWidth - 1;
        
        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('customer-reviews-{{ ai_gen_id }}', CustomerReviews{{ ai_gen_id }});
  })();
</script>

