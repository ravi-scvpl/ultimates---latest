{% doc %}
  @prompt
    generate a comparison snapshot table to show the following text:  | Feature          | UltiScrape | UltiWipe | Hybrid |
    | ---------------- | ---------- | -------- | ------ |
    | Dirt scraping    | ★★★★★      | ★★       | ★★★★   |
    | Water absorption | ★          | ★★★★★    | ★★★    |
    | Daily usability  | ★★★★       | ★★★★     | ★★★★★  |
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-comparison-table__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-align: {{ block.settings.title_alignment }};
  }

  .ai-comparison-table__wrapper-{{ ai_gen_id }} {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ai-comparison-table__content-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    min-width: 100%;
  }

  .ai-comparison-table__content-{{ ai_gen_id }} th,
  .ai-comparison-table__content-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.cell_alignment }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table__content-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_bg_color }};
    color: {{ block.settings.header_text_color }};
    font-size: {{ block.settings.header_font_size }}px;
    font-weight: {{ block.settings.header_font_weight }};
  }

  .ai-comparison-table__content-{{ ai_gen_id }} td {
    background-color: {{ block.settings.cell_bg_color }};
    color: {{ block.settings.cell_text_color }};
    font-size: {{ block.settings.cell_font_size }}px;
  }

  .ai-comparison-table__content-{{ ai_gen_id }} tbody tr:nth-child(even) td {
    background-color: {{ block.settings.cell_alt_bg_color }};
  }

  .ai-comparison-table__star-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: {{ block.settings.star_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table__content-{{ ai_gen_id }} th,
    .ai-comparison-table__content-{{ ai_gen_id }} td {
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
      font-size: {{ block.settings.cell_font_size | times: 0.9 }}px;
    }

    .ai-comparison-table__content-{{ ai_gen_id }} th {
      font-size: {{ block.settings.header_font_size | times: 0.9 }}px;
    }

    .ai-comparison-table__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-comparison-table__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  <div class="ai-comparison-table__wrapper-{{ ai_gen_id }}">
    <table class="ai-comparison-table__content-{{ ai_gen_id }}">
      <thead>
        <tr>
          <th>{{ block.settings.header_col_1 }}</th>
          <th>{{ block.settings.header_col_2 }}</th>
          <th>{{ block.settings.header_col_3 }}</th>
          <th>{{ block.settings.header_col_4 }}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{{ block.settings.row_1_label }}</td>
          <td><span class="ai-comparison-table__star-{{ ai_gen_id }}">{{ block.settings.row_1_col_2 }}</span></td>
          <td><span class="ai-comparison-table__star-{{ ai_gen_id }}">{{ block.settings.row_1_col_3 }}</span></td>
          <td><span class="ai-comparison-table__star-{{ ai_gen_id }}">{{ block.settings.row_1_col_4 }}</span></td>
        </tr>
        <tr>
          <td>{{ block.settings.row_2_label }}</td>
          <td><span class="ai-comparison-table__star-{{ ai_gen_id }}">{{ block.settings.row_2_col_2 }}</span></td>
          <td><span class="ai-comparison-table__star-{{ ai_gen_id }}">{{ block.settings.row_2_col_3 }}</span></td>
          <td><span class="ai-comparison-table__star-{{ ai_gen_id }}">{{ block.settings.row_2_col_4 }}</span></td>
        </tr>
        <tr>
          <td>{{ block.settings.row_3_label }}</td>
          <td><span class="ai-comparison-table__star-{{ ai_gen_id }}">{{ block.settings.row_3_col_2 }}</span></td>
          <td><span class="ai-comparison-table__star-{{ ai_gen_id }}">{{ block.settings.row_3_col_3 }}</span></td>
          <td><span class="ai-comparison-table__star-{{ ai_gen_id }}">{{ block.settings.row_3_col_4 }}</span></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

