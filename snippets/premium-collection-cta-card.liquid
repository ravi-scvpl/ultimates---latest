<div class="col-span-2 md:col-span-2 rounded-2xl p-12 flex flex-col md:flex-row items-center justify-between gap-8 my-4 text-left hover:scale-[1.01] transition-transform duration-300" style="background-color: {{ section.settings.cta_bg | default: '#000000' }}; color: {{ section.settings.cta_text_color | default: '#ffffff' }};">
  <div class="max-w-md">
    <h3 class="font-display-xl text-3xl mb-4 font-normal" style="color: {{ section.settings.cta_text_color | default: '#ffffff' }};">
      {{ section.settings.cta_heading | default: 'Need a custom size?' }}
    </h3>
    <p class="font-body-md text-sm leading-relaxed opacity-80">
      {{ section.settings.cta_description | default: 'We manufacture bespoke barrier solutions for unique architectural footprints. Request a made-to-measure quote today.' }}
    </p>
  </div>
  <a href="{{ section.settings.m2m_url | default: '/pages/made-to-measure-page' }}" class="bg-white text-primary px-10 py-4 rounded-full font-label-md text-label-md hover:scale-105 transition-transform whitespace-nowrap text-center block" style="color: #000000; background-color: #ffffff;">
    {{ section.settings.cta_btn_text | default: 'Request Quote' }}
  </a>
</div>
