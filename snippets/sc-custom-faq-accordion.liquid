<script>
  // accordion js

  function toggleAccordion(clickedHeader) {
    const accordionItem = clickedHeader.parentNode;
    const accordionBody = accordionItem.querySelector('.accordion-body');
    const icon = accordionItem.querySelector('.icon');

    // Toggle current accordion
    const isAccordionOpen = accordionBody.classList.toggle('open');
    accordionBody.style.maxHeight = isAccordionOpen ? `${accordionBody.scrollHeight + 20}px` : '0'; /* Add the padding value */
    accordionBody.style.padding = isAccordionOpen ? '10px' : '0'; /* Toggle padding based on accordion state */

    // Toggle rotate class for the icon
    icon.classList.toggle('rotate', isAccordionOpen);

    // Toggle active class for the accordion header
    clickedHeader.classList.toggle('active', isAccordionOpen);

    // If the clicked accordion is open, close the others
    if (isAccordionOpen) {
      const allAccordions = document.querySelectorAll('.accordion-item');
      allAccordions.forEach((item) => {
        if (item !== accordionItem) {
          const otherAccordionBody = item.querySelector('.accordion-body');
          const otherAccordionIcon = item.querySelector('.icon');
          const otherAccordionHeader = item.querySelector('.accordion-header');

          otherAccordionBody.classList.remove('open');
          otherAccordionBody.style.maxHeight = '0';
          otherAccordionBody.style.padding = '0';
          otherAccordionIcon.classList.remove('rotate');
          otherAccordionHeader.classList.remove('active');
        }
      });
    }
  }

</script>
<style>

.sc-faq-accordion {
    width: 60%;
    margin: 4rem auto 0;
}
  .sc-faq-accordion h2 {
    text-transform: capitalize;
}
  @media(max-width:768px){
    .sc-faq-accordion {
    width: 92%;
    margin: auto;
}
    .accordion-header span {
  
    font-size: 15px;
}
  }
  /* accordion content section end here */
</style>