    "collapsible_content_QXqK9a": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_WD6BM3": {
          "type": "collapsible_row",
          "settings": {
            "row_icon": "none",
            "title": "Why choose UltiClean?",
            "row_content": "<p>UltiClean offers a plush, luxurious aesthetic combined with robust dirt-trapping and moisture absorption capabilities, making it ideal for entrance doorways, office spaces, reception areas, and residential interiors.</p>",
            "page": ""
          }
        },
        "collapsible_row_tdPPJk": {
          "type": "collapsible_row",
          "settings": {
            "row_icon": "none",
            "title": "Is UltiClean easy to clean?",
            "row_content": "<p>Yes. UltiClean is 100% washable and quick-drying. Tap or vacuum for light cleaning or hose-down with water for deep-cleaning.</p>",
            "page": ""
          }
        },
        "collapsible_row_jGM4U8": {
          "type": "collapsible_row",
          "settings": {
            "row_icon": "none",
            "title": "Why should a mat have double-compressed borders?",
            "row_content": "<p>Double-compressed vinyl borders help significantly reduce trip and fall accidents, increase mat longevity by preventing edge fraying, and give an overall neat and finished appearance.</p>",
            "page": ""
          }
        },
        "collapsible_row_3JfeEa": {
          "type": "collapsible_row",
          "settings": {
            "row_icon": "none",
            "title": "Are there any regulatory guidelines on commercial entrance matting?",
            "row_content": "<p>The Americans with Disabilities Act sets specific code regulations for public and commercial buildings so that people with a wide range of disabilities can freely and easily access all areas. UltiClean satisfies ADA regulatory guidelines with its low profile and ramped borders.</p>",
            "page": ""
          }
        }
      },
