edia_6wdzp9","media_WmDHpJ"],"settings":{"show_scrim":true,"scrim_lightness":0,"title":"","subtitle":"","social_link":"social_instagram_link","font_size":100,"background":"background-modal","frosted_glass":false,"padding_top":44,"padding_bottom":44}},"checklist_iP6XbV":{"type":"checklist","blocks":{"line_text_fDihxG":{"type":"line_text","settings":{"icon":"shield-check","text":"High scraping action on dirt"}},"line_text_CrhqBR":{"type":"line_text","settings":{"icon":"shield-check","text":"Luxurious dual-tone surface look"}},"line_text_UXwHwM":{"type":"line_text","settings":{"icon":"shield-check","text":"Double-compressed borders"}},"line_text_nGaDrD":{"type":"line_text","settings":{"icon":"shield-check","text":"Sleek 8mm height design"}},"line_text_DjKTLw":{"type":"line_text","settings":{"icon":"shield-check","text":"Washable & easy to maintain"}},"line_text_wJMWyM":{"type":"line_text","settings":{"icon":"shield-check","text":"made in india"}}},"block_order":["line_text_fDihxG","line_text_CrhqBR","line_text_UXwHwM","line_text_nGaDrD","line_text_DjKTLw","line_text_wJMWyM"],"settings":{"image":"shopify:\/\/shop_images\/product-option-ultiscrapem2m-grey-black.png","show_scrim":false,"scrim_lightness":0,"icon":"shield-check","text":"","link":"","font_size":70,"font_type":"heading-font","background":"background-modal","margin_top":44,"margin_bottom":44}},"large_media_with_text_box_wcgMWJ":{"type":"large-media-with-text-box","blocks":{"heading_QaYLWq":{"type":"heading","settings":{"title":"Technical specifications","font_size":80}},"text_6XWaJr":{"type":"text","settings":{"text":"<p>Product Name: UltiGrate<\/p><p>Application: Commercial heavy-traffic entrances<\/p><p>Material: Aluminium 6063T6 Anodized<\/p><p>Mat infills: Brush\/Rubber\/Carpet<\/p><p>Profile Height : 10 mm<\/p><p>Total Height (Brush): 14 mm<\/p><p>Total Height (Carpet): 12 mm<\/p><p>Matwell Depth: 10 mm<\/p><p>Pedestrian Annual Traffic: Upto 10 million <\/p><p>Trolley Crossings: Heavy (Max weight 600 Kgs)<\/p><p>Warranty: 5 years<\/p>","font_size":100}},"button_FcqrEC":{"type":"button","disabled":true,"settings":{"button_label":"Configure your mat","button_link":""}}},"block_order":["heading_QaYLWq","text_6XWaJr","button_FcqrEC"],"disabled":true,"settings":{"image":"shopify:\/\/shop_images\/Entryway_Mat_3.jpg","autoplay_video":true,"full_width":true,"text_position":"top-left","container_width":425,"container_height":20,"inner_spacing":40,"vertical_position":39,"horizontal_position":100,"background":"background-modal","frosted_glass":false,"padding_top":44,"padding_bottom":44}},"media_with_text_A6py6b":{"type":"media-with-text","blocks":{"heading_BrLTxg":{"type":"heading","settings":{"title":"Technical specifications","font_size":80,"font_type":"heading-font"}},"text_t88i4E":{"type":"text","settings":{"text":"<p>Product Name: UltiScrape<\/p><p>Surface Material: Stiff Polypropylene<\/p><p>Carpet Style: Tufted cut-pile<\/p><p>Carpet Weight: 750 gsm<\/p><p>Backing Weight: 2000 gsm<\/p><p>Mat height: 8mm<\/p><p>Pedestrian annual traffic: 0.8 Million<\/p><p>Water Retention: 3.0 Kgs\/m2<\/p><p>Warranty: 12 months<\/p><p><\/p>","font_size":80,"font_type":"body-font"}},"button_qj8rWM":{"type":"button","settings":{"button_label":"","button_link":""}}},"block_order":["heading_BrLTxg","text_t88i4E","button_qj8rWM"],"settings":{"image":"shopify:\/\/shop_images\/UltiScrape_Rolls_Tech_Specs_Image.png","autoplay_video":true,"image_ratio":"adapt","media_width":780,"vertical_text_align":"top","layout":"left","section_align":"center","overlap_text":true,"image_animation":"fade-up","background":"background-modal","frosted_glass":true,"padding_top":44,"padding_bottom":44}},"social_media_banner_7qVQMD":{"type":"social-media-banner","blocks":{"media_RhPTHr":{"type":"media","settings":{"autoplay_video":true,"image_link":""}},"media_hMHPV6":{"type":"media","settings":{"autoplay_video":true,"image_link":""}},"media_dpzJy3":{"type":"media","settings":{"autoplay_video":true,"image_link":""}},"media_fFJrrQ":{"type":"media","settings":{"autoplay_video":true,"image_link":""}}},"block_order":["media_RhPTHr","media_hMHPV6","media_dpzJy3","media_fFJrrQ"],"disabled":true,"settings":{"show_scrim":true,"scrim_lightness":0,"title":"@yourinstagram","subtitle":"Follow us on Instagram","social_link":"social_instagram_link","font_size":100,"background":"background-modal","frosted_glass":false,"padding_top":44,"padding_bottom":44}},"collapsible_content_QXqK9a":{"type":"collapsible-content","blocks":{"collapsible_row_WD6BM3":{"type":"collapsible_row","settings":{"row_icon":"none","title":"Why UltiScrape?","row_content":"<ul><li>Stiff-fibres scrape-off tough dirt<\/li><li>Our USP: Double-compressed borders add style, longevity and neat looks<\/li><li>Dual-tone looks add elegance to your entrance<\/li><li>UltiScrape is a sleek design 8mm low-height product that allows unhindered door-movement over the mat<\/li><\/ul>","page":""}},"collapsible_row_i3RYTA":{"type":"collapsible_row","settings":{"row_icon":"none","title":"Is UltiScrape difficult to clean?","row_content":"<p>No. On the contrary, while UltiScrape scrapes-off large amounts of dirt, it is extremely easy to remove the collected dirt and debris. Simply tap or vacuum away the dirt, or hose-down with water once a while for deep-cleaning. UltiScrape is quick to dry for reuse. <\/p>","page":""}},"collapsible_row_3JfeEa":{"type":"collapsible_row","settings":{"row_icon":"none","title":"Are there any regulatory guidelines on commercial entrance matting?","row_content":"<p>The Americans with Disabilities Act sets specific codes regulations for public and commercial buildings so that people with a wide range of disabilities can freely and easily access all areas of these buildings. The ADA even has very specific guidelines on entrance mats. The best mats for wheelchairs are our recessed metal mats and our surface-mount mats. Ensure easy access to all who enter your facility.<\/p><p><strong>The ADA has these set of guidelines:<\/strong><\/p><p>Carpet must be securely affixed to the ground, have a stiff or no backing at all, and be no more than 12.5mm thick. If the carpet is more than 12.5mm thick, there must be a beveled edge for wheels to effortlessly glide over.<br\/><\/p><p>Recessed entrance grates\/mats need to have less than 12.5mm between pieces to prevent wheels or any other movement facilitating equipment to get caught.<\/p><p>UltiScrape satisfies all ADA regulatory guidelines.<\/p>","page":""}}},"block_order":["collapsible_row_WD6BM3","collapsible_row_i3RYTA","collapsible_row_3JfeEa"],"settings":{"show_information":false,"title":"FAQ","description":"<p>It can be a challenge to pick the correct barrier matting for your entrance. We've compiled a list of frequently asked questions to help you decide which style is the right choice for your facility. No matter what your needs may be, Ultimats always has the right product for you!<\/p>","email_label":"","email":"","phone_label":"","phone":"","hours_label":"","hours":"","font_size":100,"background":"background-modal","padding_top":44,"padding_bottom":44}},"rich_text_aXwYKq":{"type":"rich-text","blocks":{"heading_4Nj7Yb":{"type":"heading","settings":{"heading":"","font_size":100,"font_type":"heading-font"}},"text_wHc3Q9":{"type":"text","settings":{"text":"","font_size":100,"font_type":"heading-font"}},"button_4WLFMY":{"type":"button","settings":{"button_label":"customize your ultiscrape","button_link":"https:\/\/ultimats.com\/products\/ultiscrape-carpet-mat","button_style":"solid"}}},"block_order":["heading_4Nj7Yb","text_wHc3Q9","button_4WLFMY"],"settings":{"text_align":"center","background":"main-background","padding_top":0,"padding_bottom":0}},"contact_form_awRX6D":{"type":"contact-form","settings":{"heading":"need product support or a quote?","subtitle":"Our Customer Service Team Will Connect With You","show_email":false,"show_phone":false,"show_address":false,"custom_address":"","show_facebook":false,"handle_facebook":"Find us on Facebook","show_instagram":false,"handle_instagram":"Find us on Instagram","show_twitter":false,"handle_twitter":"Find us on Twitter","operation":"","response_time":"Thank you for contacting us. We will respond within 2 working days","font_size":100,"background":"main-background","padding_top":44,"padding_bottom":44}}},"order":["hero_image_GFbDEd","main","rich_text_jEwqRH","media_with_text_QiiP9T","media_with_text_EcWNza","media_with_text_HTDLiR","social_media_banner_QkKgiN","checklist_iP6XbV","large_media_with_text_box_wcgMWJ","media_with_text_A6py6b","social_media_banner_7qVQMD","collapsible_content_QXqK9a","rich_text_aXwYKq","contact_form_awRX6D"]}