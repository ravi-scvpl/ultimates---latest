:44,"padding_bottom":44}},"media_with_text_f6VaAm":{"type":"media-with-text","blocks":{"heading_xKT8RP":{"type":"heading","settings":{"title":"Technical Specifications","font_size":80,"font_type":"heading-font"}},"text_rRUwgB":{"type":"text","settings":{"text":"<p>Product Name: UltiDure<\/p><p>Application: Commercial heavy-traffic interior\/exterior use<\/p><p>Surface Material: Polyamide high-twist heat-set frieze carpet<\/p><p>Backing Material: Nitrile rubber<\/p><p>Product Height : 10 mm<\/p><p>Total Weight : 2.75 Kgs\/m2<\/p><p>Water-retention capacity: 4.0 l\/m2<\/p><p>Borders: 18 mm reinforced nbr<\/p><p>Pedestrian Annual Traffic: Upto 1 million <\/p><p>Warranty: 1.5 years<\/p>","font_size":80,"font_type":"body-font"}},"button_CcRHKM":{"type":"button","settings":{"button_label":"","button_link":""}}},"block_order":["heading_xKT8RP","text_rRUwgB","button_CcRHKM"],"settings":{"image":"shopify:\/\/shop_images\/UltiDure_Grey_Brown_Burgundy_CloseUp_Rolled.webp","autoplay_video":true,"image_ratio":"5-4","media_width":780,"vertical_text_align":"top","layout":"left","section_align":"left","overlap_text":true,"image_animation":"fade-up","background":"background-modal","frosted_glass":true,"padding_top":44,"padding_bottom":44}},"size_chart_aUX3X4":{"type":"size-chart","blocks":{"row_gTPUWL":{"type":"row","settings":{"is_thead":true,"row_name":"Product Name","column_values":"UltiDure Commercial Entrance Mat"}},"row_wcaWrN":{"type":"row","settings":{"is_thead":false,"row_name":"Application Areas","column_values":"Malls Hotels Office Entrances & Hospitals"}},"row_KcjPQx":{"type":"row","settings":{"is_thead":false,"row_name":"Size Options","column_values":"Pre-sized & Custom sizes available"}},"row_RNKNL4":{"type":"row","settings":{"is_thead":false,"row_name":"Surface Material","column_values":"Twisted Heat-Set Frieze Polyamide Yarn"}}},"block_order":["row_gTPUWL","row_wcaWrN","row_KcjPQx","row_RNKNL4"],"disabled":true,"name":"t:sections.size-chart.presets.name","settings":{"title":"Technical Specifications","note":"","background":"background-modal","padding_top":20,"padding_bottom":44}},"large_media_with_text_box_wcgMWJ":{"type":"large-media-with-text-box","blocks":{"heading_QaYLWq":{"type":"heading","settings":{"title":"Technical specifications","font_size":80}},"text_6XWaJr":{"type":"text","settings":{"text":"<p>Product Name: UltiGrate<\/p><p>Application: Commercial heavy-traffic entrances<\/p><p>Material: Aluminium 6063T6 Anodized<\/p><p>Mat infills: Brush\/Rubber\/Carpet<\/p><p>Profile Height : 10 mm<\/p><p>Total Height (Brush): 14 mm<\/p><p>Total Height (Carpet): 12 mm<\/p><p>Matwell Depth: 10 mm<\/p><p>Pedestrian Annual Traffic: Upto 10 million <\/p><p>Trolley Crossings: Heavy (Max weight 600 Kgs)<\/p><p>Warranty: 5 years<\/p>","font_size":100}},"button_FcqrEC":{"type":"button","disabled":true,"settings":{"button_label":"Configure your mat","button_link":""}}},"block_order":["heading_QaYLWq","text_6XWaJr","button_FcqrEC"],"disabled":true,"settings":{"image":"shopify:\/\/shop_images\/Entryway_Mat_3.jpg","autoplay_video":true,"full_width":true,"text_position":"top-left","container_width":425,"container_height":20,"inner_spacing":40,"vertical_position":39,"horizontal_position":100,"background":"background-modal","frosted_glass":false,"padding_top":44,"padding_bottom":44}},"collapsible_content_QXqK9a":{"type":"collapsible-content","blocks":{"collapsible_row_WD6BM3":{"type":"collapsible_row","settings":{"row_icon":"none","title":"How is UltiDure a premium carpet matting product?","row_content":"<ul><li>The carpet is tufted from PA 6.6, renowned for its durability, making it the ideal yarn for floor matting<\/li><li>The yarn is tightly twisted and heat-set - a process that effectively hides footprints on the carpet surface<\/li><li>The backing is composed of nitrile rubber, known for its exceptional flexibility and grip, which empowers the mat with a 100% anti-skid feature. <\/li><li>Mat borders are reinforced with extra nitrile rubber ensuring they are non-tearable<\/li><\/ul>","page":""}},"collapsible_row_g3dFpC":{"type":"collapsible_row","settings":{"row_icon":"none","title":"How is UltiDure effective against dirt and moisture?","row_content":"<p>The spacing between individual carpet tufts and the tight twist in the yarn have been functionally designed to form an optimal environment for trapping and concealing dirt and moisture, while facilitating effortless removal during cleaning. This guarantees that the surface of the mat stays pristine and fresh all day long.<\/p>","page":""}},"collapsible_row_tdPPJk":{"type":"collapsible_row","settings":{"row_icon":"none","title":"Is UltiDure really so tough that it can be thrown in a washing-machine for cleaning?","row_content":"<p>Yes. UltiDure is 100% machine-washable and can withstand over 150 commercial laundry wash-cycles.<\/p>","page":""}},"collapsible_row_3JfeEa":{"type":"collapsible_row","settings":{"row_icon":"none","title":"What is the purpose of having two styles of backing - plain and nibbed?","row_content":"<p>The backing style depends on the type of floor where UltiDure is placed. Use UltiDure Plain Backing for flat surfaces like stone, wood etc. and UltiDure Nibbed Backing over carpetted floors. Using the right backing product for a floor surface ensures full-enjoyment of its 100% anti-skid properties<\/p>","page":""}}},"block_order":["collapsible_row_WD6BM3","collapsible_row_g3dFpC","collapsible_row_tdPPJk","collapsible_row_3JfeEa"],"settings":{"show_information":false,"title":"FAQ","description":"<p>We've compiled a list of frequently asked questions to help you decide which matting configuration is the right choice for your premises. No matter what your needs may be, Ultimats has the right product for you.<\/p>","email_label":"","email":"","phone_label":"","phone":"","hours_label":"","hours":"","font_size":100,"background":"background-modal","padding_top":44,"padding_bottom":44}},"rich_text_UgtPzt":{"type":"rich-text","blocks":{"headi