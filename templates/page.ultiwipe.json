el":"","button_link":""}}},"block_order":["heading_xKT8RP","text_rRUwgB","button_CcRHKM"],"settings":{"image":"shopify:\/\/shop_images\/UltiWipe_6x4_Y_with_Color_Swatches.png","autoplay_video":true,"image_ratio":"adapt","media_width":780,"vertical_text_align":"top","layout":"left","section_align":"left","overlap_text":true,"image_animation":"discover-image","background":"background-modal","frosted_glass":true,"padding_top":44,"padding_bottom":44}},"large_media_with_text_box_wcgMWJ":{"type":"large-media-with-text-box","blocks":{"heading_QaYLWq":{"type":"heading","settings":{"title":"Technical specifications","font_size":80}},"text_6XWaJr":{"type":"text","settings":{"text":"<p>Product Name: UltiGrate<\/p><p>Application: Commercial heavy-traffic entrances<\/p><p>Material: Aluminium 6063T6 Anodized<\/p><p>Mat infills: Brush\/Rubber\/Carpet<\/p><p>Profile Height : 10 mm<\/p><p>Total Height (Brush): 14 mm<\/p><p>Total Height (Carpet): 12 mm<\/p><p>Matwell Depth: 10 mm<\/p><p>Pedestrian Annual Traffic: Upto 10 million <\/p><p>Trolley Crossings: Heavy (Max weight 600 Kgs)<\/p><p>Warranty: 5 years<\/p>","font_size":100}},"button_FcqrEC":{"type":"button","disabled":true,"settings":{"button_label":"Configure your mat","button_link":""}}},"block_order":["heading_QaYLWq","text_6XWaJr","button_FcqrEC"],"disabled":true,"settings":{"image":"shopify:\/\/shop_images\/Entryway_Mat_3.jpg","autoplay_video":true,"full_width":true,"text_position":"top-left","container_width":425,"container_height":20,"inner_spacing":40,"vertical_position":39,"horizontal_position":100,"background":"background-modal","frosted_glass":false,"padding_top":44,"padding_bottom":44}},"collapsible_content_QXqK9a":{"type":"collapsible-content","blocks":{"collapsible_row_WD6BM3":{"type":"collapsible_row","settings":{"row_icon":"none","title":"Why UltiWipe?","row_content":"<ul><li>Stiff-fibres scrape-off tough dirt<\/li><li>Soft-fibers retain moisture<\/li><li>Our USP: Double-compressed borders add style, longevity and neat looks<\/li><li>Dual-tone looks add elegance to your entrance<\/li><li>UltiWipe is a sleek design 8mm low-height product that allows unhindered door-movement over the mat<\/li><\/ul>","page":""}},"collapsible_row_g3dFpC":{"type":"collapsible_row","settings":{"row_icon":"none","title":"How is UltiWipe effective against dirt and moisture?","row_content":"<p>UltiWipe is purposefully crafted to create the perfect conditions for capturing and hiding dirt and moisture, making cleaning effortless while ensuring the mat's surface remains clean and fresh throughout the day.<\/p>","page":""}},"collapsible_row_tdPPJk":{"type":"collapsible_row","settings":{"row_icon":"none","title":"How do I clean UltiWipe?","row_content":"<p>UltiWipe is 100% washable and quick-drying. Tap or vacuum for light cleaning or hose-down with water for deep-cleaning<\/p>","page":""}},"collapsible_row_3JfeEa":{"type":"collapsible_row","settings":{"row_icon":"none","title":"Are there any regulatory guidelines on commercial entrance matting?","row_content":"<p>The Americans with Disabilities Act sets specific codes regulations for public and commercial buildings so that people with a wide range of disabilities can freely and easily access all areas of these buildings. The ADA even has very specific guidelines on entrance mats. The best mats for wheelchairs are our recessed metal mats and our surface-mount mats. Ensure easy access to all who enter your facility.<\/p><p><strong>The ADA has these set of guidelines:<\/strong><\/p><p>Carpet must be securely affixed to the ground, have a stiff or no backing at all, and be no more than 12.5mm thick. If the carpet is more than 12.5mm thick, there must be a beveled edge for wheels to effortlessly glide over.<br\/><\/p><p>Recessed entrance grates\/mats need to have less than 12.5mm between pieces to prevent wheels or any other movement facilitating equipment to get caught.<\/p><p>UltiWipe satisfies all ADA regulatory guidelines.<\/p>","page":""}}},"block_ord