e,"row_name":"Total Weight","column_values":"5.50 Kg\/m2, 3.50 Kg\/m2"}},"row_MMePqm":{"type":"row","settings":{"is_thead":false,"row_name":"Strand Diameter","column_values":"0.75mm, 0.45mm"}},"row_nBxpLH":{"type":"row","settings":{"is_thead":false,"row_name":"Strand Diameter","column_values":"0.75mm, 0.45mm"}},"row_aRJj37":{"type":"row","settings":{"is_thead":false,"row_name":"Flammability DIN 5239-1","column_values":"Cfl-s1, Cfl-s1"}},"row_HLUYaX":{"type":"row","settings":{"is_thead":false,"row_name":"Foot passes (annually)*","column_values":"0.75 million, 0.5 million"}},"row_iEa3rp":{"type":"row","settings":{"is_thead":false,"row_name":"Warranty","column_values":"18 months, 12 months"}},"row_GfRBTj":{"type":"row","settings":{"is_thead":false,"row_name":"Colors","column_values":"grey | Black | Red, grey | Black | Red"}}},"block_order":["row_bbMkWj","row_9HPCc8","row_XcwjiD","row_aEAz39","row_Pyq9if","row_MMePqm","row_nBxpLH","row_aRJj37","row_HLUYaX","row_iEa3rp","row_GfRBTj"],"custom_css":["h2 {font-size: 18px;}"],"settings":{"title":"ULTIMAT TECHNICAL SPECIFICATIONS","note":"subject to adhering to recommended maintenance instructions","background":"background-modal","padding_top":44,"padding_bottom":44}},"collapsible_content_QXqK9a":{"type":"collapsible-content","blocks":{"collapsible_row_WD6BM3":{"type":"collapsible_row","settings":{"row_icon":"none","title":"Why Ultimat?","row_content":"<ul><li>Functional surface loop-construction for effective trapping and removal of dirt <\/li><li>Balanced open structure allows all dirt and moisture to fall through<\/li><li>All-around compressed borders to prevent fraying, increased longevity and aesthetics<\/li><li>Ultimat is made using non-toxic prime grade vinyl materials that are REACH and ROHS compliant<\/li><\/ul>","page":""}},"collapsible_row_wnHViU":{"type":"collapsible_row","settings":{"row_icon":"none","title":"Should I order Ultimat with or without borders?","row_content":"<p>if you are placing the mat in a matwell or recessed area, you should pick our product without borders. If however, the mat will be laid loose on a flat floor, we recommend our all-around compressed borders as they significantly reduce trip and fall accidents, increase mat longevity and are aesthetically more appealing, giving an overall neat and finished appearance.<\/p>","page":""}},"collapsible_row_3JfeEa":{"type":"collapsible_row","settings":{"row_icon":"none","title":"Are there any regulatory guidelines on commercial entrance matting?","row_content":"<p>The Americans with Disabilities Act sets specific codes regulations for public and commercial buildings so that people with a wide range of disabilities can freely and easily access all areas of these buildings. The ADA even has very specific guidelines on entrance mats. The best mats for wheelchairs are our recessed metal mats and our surface-mount mats. Ensure easy access to all who enter your facility.<\/p><p><strong>The ADA has these set of guidelines:<\/strong><\/p><p>Carpet must be securely affixed to the ground, have a stiff or no backing at all, and be no more than 12.5mm thick. If the carpet is more than 12.5mm thick, there must be a beveled edge for wheels to effortlessly glide over.<br\/><\/p><p>Recessed entrance grates\/mats need to have less than 12.5mm between pieces to prevent wheels or any other movement facilitating equipment to get caught.<\/p><p>Ultimat satisfies all ADA regulatory guidelines.<\/p>","page":""}}},"block_order":["collapsible_row_WD6BM3","collapsible_row_wnHViU","collapsible_row_3JfeEa"],"settings":{"show_information":false,"title":"FAQ","description":"<p>It can be hard to choose the most suitable barrier matting for your premises. We've compiled a list of frequently asked questions to help you decide which configuration is the right choice for your facility. No matter what your needs may be, Ultimats has the right product for you.<\/p>","email_label":"","email":"","phone_label":"","phone":"","hours_label":"","hours":"","font_size":100,"background":"background-modal","padding_top":44,"padding_bottom":44}},"rich_text_336mK4":{"type":"rich-text","blocks":{"heading_9iNxxC":{"type":"heading","settings":{"heading":"","font_size":100,"font_type":"heading-font"}},"text_bn8WDj":{"type":"text","settings":{"text":"","font_size":100,"font_type":"body-font"}},"button_nawpPW":{"type":"button","settings":{"button_label":"Customize Your Ultimat","button_link":"https:\/\/ultimats.com\/products\/ultimat-heavy-duty-vinyl-looped-mat","button_style":"solid"}}},"block_order":["heading_9iNxxC","text_bn8WDj","button_nawpPW"],"settings":{"text_align":"center","background":"main-background","padding_top":0,"padding_bottom":0}},"contact_form_awRX6D":{"type":"contact-form","settings":{"heading":"need product support or a quote?","subtitle":"Our Customer Service Team Will Connect With You","show_email":false,"show_phone":false,"show_address":false,"custom_address":"","show_facebook":false,"handle_facebook":"Find us on Facebook","show_instagram":false,"handle_instagram":"Find us on Instagram","show_twitter":false,"handle_twitter":"Find us on Twitter","operation":"","response_time":"Thank you for contacting us. We will respond within 2 working days","font_size":100,"background":"main-background","padding_top":44,"padding_bottom":44}}},"order":["main","hero_image_n9bfmT","media_with_text_rYcgPq","collection_list_fDfR44","media_with_text_wpFQ8k","checklist_iP6XbV","size_chart_M4cPwV","collapsible_content_QXqK9a","rich_text_336mK4","contact_form_awRX6D"]}