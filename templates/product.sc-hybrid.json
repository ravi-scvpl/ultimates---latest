       <div class=\"color-name\">Red Black</div>\n        </div>\n        <div class=\"color-item\" data-url=\"https://ultimats.com/products/ultiwipe-cleanscrape-all-weather-mat-brown-black\">\n          <div class=\"color-circle\" style=\"background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/WhatsApp_Image_2025-07-18_at_09.57.12.jpg?v=1753163820');\"></div>\n          <div class=\"color-name\">Brown Black</div>\n        </div>\n        <div class=\"color-item\" data-url=\"https://ultimats.com/products/ultiwipe-cleanscrape-all-weather-mat-green-black\">\n          <div class=\"color-circle\" style=\"background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/WhatsApp_Image_2025-07-18_at_09.57.13.jpg?v=1753163820');\"></div>\n          <div class=\"color-name\">Green Black</div>\n        </div>\n      </div>\n  </div>\n\n  <script>\n    document.querySelectorAll('.color-item').forEach(function(item) {\n      item.addEventListener('click', function() {\n        const targetUrl = item.getAttribute('data-url');\n        window.location.href = targetUrl; // Redirect to the page\n      });\n    });\n  </script>\n{% endif %}"
