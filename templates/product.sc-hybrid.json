            "custom_liquid": "<div id=\"size-offer-box\" class=\"size-offer-box\" style=\"display:none;\">\n  <p class=\"offer-heading\">Special Offer (Valid only on 2ft x 3ft)</p>\n  \n  <div class=\"offer-row\">\n    <span>Buy 2 Mats</span>\n    <span class=\"discount\">7% OFF</span>\n  </div>\n\n  <div class=\"offer-row\">\n    <span>Buy 3 Mats</span>\n    <span class=\"discount\">10% OFF</span>\n  </div>\n</div>\n\n<style>\n.size-offer-box {\n  margin-top: 15px;\n  padding: 16px;\n  border-radius: 10px;\n  background: #f4f9ff;\n  border: 1px solid #d6eaff;\n}\n\n.offer-heading {\n  font-weight: 600;\n  font-size: 16px;\n  margin-bottom: 10px;\n  color: #0d6efd;\n}\n\n.offer-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 6px 0;\n  font-size: 14px;\n  border-bottom: 1px dashed #ddd;\n}\n\n.offer-row:last-child {\n  border-bottom: none;\n}\n\n.discount {\n  background: #000;\n  color: #fff;\n  padding: 4px 10px;\n  border-radius: 20px;\n  font-size: 13px;\n  font-weight: 500;\n}\n</style>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n\n  const offerBox = document.getElementById(\"size-offer-box\");\n\n  // FIRST VARIANT ID (Automatically from Shopify)\n  const firstVariantId = {{ product.variants.first.id }};\n\n  function checkVariant() {\n    const currentVariantInput = document.querySelector('input[name=\"id\"]');\n    \n    if (!currentVariantInput) return;\n\n    const selectedVariantId = parseInt(currentVariantInput.value);\n\n    if (selectedVariantId === firstVariantId) {\n      offerBox.style.display = \"block\";\n    } else {\n      offerBox.style.display = \"none\";\n    }\n  }\n\n  // Detect variant change\n  document.addEventListener(\"change\", function(e) {\n    if (e.target.name === \"id\" || e.target.closest(\"variant-radios\") || e.target.closest(\"variant-selects\")) {\n      setTimeout(checkVariant, 200);\n    }\n  });\n\n  checkVariant();\n});\n</script>\n\n<br>"
