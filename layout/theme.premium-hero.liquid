<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <!-- Local Premium Theme Route Handler -->
    <script>
      (function() {
        var path = window.location.pathname.replace(/\/$/, '').toLowerCase();
        var search = window.location.search.toLowerCase();
        
        var premiumRoutes = {
          '': '/pages/contact?view=premium-hero',
          '/': '/pages/contact?view=premium-hero',
          '/commercial': '/pages/contact?view=commercial',
          '/pages/commercial': '/pages/contact?view=commercial',
          '/made-to-measure': '/pages/contact?view=made-to-measure-page',
          '/pages/made-to-measure': '/pages/contact?view=made-to-measure-page',
          '/made-to-measure-page': '/pages/contact?view=made-to-measure-page',
          '/pages/made-to-measure-page': '/pages/contact?view=made-to-measure-page',
          '/shop': '/collections/all',
          '/pages/shop': '/collections/all',
          '/blog': '/blogs/news',
          '/pages/blog': '/blogs/news',
          '/about-us': '/pages/contact?view=about',
          '/pages/about-us': '/pages/contact?view=about',
          '/page/about-us': '/pages/contact?view=about',
          '/pages/about': '/pages/contact?view=about',
          '/page/about': '/pages/contact?view=about',
          '/about': '/pages/contact?view=about',
          '/contact': '/pages/contact',
          '/contact-us': '/pages/contact',
          '/pages/contact-us': '/pages/contact',
          '/page/contact-us': '/pages/contact',
          '/page/contact': '/pages/contact'
        };

        var cleanRoutes = {
          'view=premium-hero': '/',
          'view=commercial': '/commercial',
          'view=made-to-measure-page': '/made-to-measure',
          'view=about': '/about-us'
        };

        if (search.indexOf('view=premium-hero') !== -1) {
          sessionStorage.setItem('premium_mode', 'true');
        }

        if (premiumRoutes[path] && premiumRoutes[path] !== path) {
          window.location.href = premiumRoutes[path];
          return;
        }

        if (path === '/pages/contact') {
          var cleaned = false;
          for (var key in cleanRoutes) {
            if (search.indexOf(key) !== -1) {
              window.history.replaceState(null, '', cleanRoutes[key]);
              cleaned = true;
              break;
            }
          }
          if (!cleaned && search === '') {
            window.history.replaceState(null, '', '/contact');
          }
        }

        if (path.indexOf('/products/') !== -1) {
          if (search.indexOf('view=premium-hero') !== -1) {
            var newSearch = window.location.search.replace(/[?&]view=premium-hero/gi, '');
            if (newSearch.startsWith('&')) {
              newSearch = '?' + newSearch.substring(1);
            }
            var newUrl = window.location.pathname + newSearch + window.location.hash;
            window.history.replaceState(null, '', newUrl);
          } else {
            var separator = window.location.search ? '&' : '?';
            window.location.href = window.location.pathname + window.location.search + separator + 'view=premium-hero' + window.location.hash;
          }
        }
      })();
    </script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="canonical" href="{{ canonical_url }}">
    
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    <!-- Scoped Google Fonts and Material Symbols for flawless stand-alone premium UI styling -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block" rel="stylesheet" />

