    </script>
    <style>
      .grid-bg {
        background-image: linear-gradient(#191715 1px, transparent 1px), linear-gradient(90deg, #191715 1px, transparent 1px);
        background-size: 32px 32px;
        opacity: 0.04;
      }
      .glass-card {
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(25, 23, 21, 0.1);
      }
      .custom-shadow {
        box-shadow: 0 40px 80px -20px rgba(25, 23, 21, 0.04);
      }
      details > summary { list-style: none; }
      details > summary::-webkit-details-marker { display: none; }
      
      body.premium-hero-layout {
        background-color: #fdf9f1;
        color: #1c1c17;
        font-family: 'Inter', sans-serif;
      }
    </style>

    {{ content_for_header }}
    <link rel="stylesheet" href="{{ 'scv-ultimats-premium.css' | asset_url }}">
  </head>
  <body class="premium-hero-layout bg-surface font-body-md text-on-surface selection:bg-primary-fixed selection:text-primary">
    <!-- Grid Pattern Overlay -->
    <div class="fixed inset-0 grid-bg pointer-events-none z-0"></div>

    <!-- Sticky Premium Navigation Header -->
    {% section 'premium-header' %}

    <!-- Main Content Slot -->
    <main id="MainContent" class="relative z-10" role="main">
      {{ content_for_layout }}
    </main>

    <!-- Premium Footer -->
    {% section 'premium-footer' %}

    <script>
      // Accordion effect for details elements
      document.querySelectorAll('details').forEach((el) => {
        el.addEventListener('toggle', (e) => {
          if (el.open) {
            document.querySelectorAll('details').forEach((otherEl) => {
              if (otherEl !== el) otherEl.open = false;
            });
          }
        });
      });

      // Automatically append ?view=premium-hero to all product links for premium experience
      (function() {
        function appendPremiumHeroParam() {
          document.querySelectorAll('a[href*="/products/"]').forEach(function(link) {
            var href = link.getAttribute('href');
            if (href && !href.includes('view=') && !href.startsWith('#') && !href.startsWith('javascript:')) {
              try {
                var url = new URL(href, window.location.origin);
                url.searchParams.set('view', 'premium-hero');
                link.setAttribute('href', url.pathname + url.search + url.hash);
              } catch(e) {
                var separator = href.indexOf('?') !== -1 ? '&' : '?';
                link.setAttribute('href', href + separator + 'view=premium-hero');
              }
            }
          });
        }
        // Run on load and DOM changes
        appendPremiumHeroParam();
        document.addEventListener('DOMContentLoaded', appendPremiumHeroParam);
        var observer = new MutationObserver(appendPremiumHeroParam);
        observer.observe(document.body, { childList: true, subtree: true });
      })();
    </script>
    
    {% render 'scv-whatsapp-widget' %}
    <script src="{{ 'scv-whatsapp-widget.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
