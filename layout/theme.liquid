  <script id="virtuenest-tracker-v2">
    (function() {
      var urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('utm_source') !== 'chatgpt.com') return;

      var shop      = "{{ shop.permanent_domain }}";
      var productId = "{{ product.id | default: 'homepage' }}";

      fetch('https://app.virtuenest.com/api/track-click', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          shop: shop,
          productId: productId,
          source: 'chatgpt',
          utm_source: 'chatgpt.com',
          original_url: window.location.href,
          referrer: document.referrer,
          userAgent: navigator.userAgent
        })
      })
      .then(function(res) { return res.ok ? res.json() : Promise.reject(res.status); })
      .then(function(data) {
        // Keep the latest clickId for cart attribution only — not for dedup.
        localStorage.setItem('vn_chatgpt_click_id', data.clickId);
        return fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            attributes: {
              vn_source: 'chatgpt',
              vn_click_id: data.clickId,
              vn_utm_source: 'chatgpt.com'
            }
          })
        });
      })
      .catch(function(err) { console.error('VirtueNest tracking error:', err); });
    })();
  </script>






