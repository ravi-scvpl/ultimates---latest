      *,
      *::before,
      *::after {
        box-sizing: inherit;
      }

      html {
        box-sizing: border-box;
        font-size: 16px;
      }

      body {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        grid-template-columns: 100%;
        min-height: 100%;
        margin: 0;
        font-size: 1rem;
        line-height: 1.65;
        font-family: var(--font-body-family) !important;
        font-style: normal;
        font-weight: 400;
        color: rgb(var(--color-base-primary-text-1));
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      /* Global Heading Hierarchy */
      h1, h2, h3, h4, h5, h6,
      .h0, .h1, .h2, .h3, .h4, .h5, .h6, .h7, .h8,
      .font-display-xl, .font-headline-lg, .font-headline-md {
        font-family: var(--font-heading-family);
        line-height: var(--font-heading-line-height, 1.25);
        color: rgb(var(--color-base-primary-text-1));
        letter-spacing: -0.015em;
      }

      /* Refined, Balanced Fluid Type Scale */
      .h0, .display-1 {
        font-size: clamp(1.75rem, 3.2vw, 2.375rem) !important;
        line-height: 1.18 !important;
        font-weight: 600 !important;
        letter-spacing: -0.02em !important;
      }

      h1, .h1 {
        font-size: clamp(1.5rem, 2.6vw, 2.125rem) !important;
        line-height: 1.22 !important;
        font-weight: 600 !important;
        letter-spacing: -0.015em !important;
      }

      h2, .h2 {
        font-size: clamp(1.25rem, 2vw, 1.625rem) !important;
        line-height: 1.28 !important;
        font-weight: 600 !important;
        letter-spacing: -0.01em !important;
      }

      h3, .h3 {
        font-size: clamp(1.05rem, 1.35vw, 1.25rem) !important;
        line-height: 1.35 !important;
        font-weight: 600 !important;
      }

      h4, .h4 {
        font-size: clamp(0.95rem, 1.1vw, 1.05rem) !important;
        line-height: 1.38 !important;
        font-weight: 600 !important;
      }

      h5, .h5 {
        font-size: 0.9rem !important;
        line-height: 1.4 !important;
        font-weight: 600 !important;
      }

      h6, .h6 {
        font-size: 0.8rem !important;
        line-height: 1.45 !important;
        font-weight: 600 !important;
      }

      /* Section Main Titles across all layouts */
      .section-header h2,
      .featured-blog h2,
      [id*="premium-featured-blog"] h2,
      [id*="premium-testimonials"] h2,
      [id*="premium-feature-grid"] h2,
      [id*="premium-media-grid"] h2,
      [id*="premium-collage"] h2 {
        font-size: clamp(1.35rem, 2.2vw, 1.85rem) !important;
        line-height: 1.25 !important;
        font-weight: 600 !important;
      }

      /* Card & Grid Article Titles (Blog cards, collection items, product cards) */
      article h3,
      article .font-headline-md,
      .article-card__title,
      .blog-articles__article h3,
      .card__heading,
      .card-information__text {
        font-size: clamp(0.95rem, 1.15vw, 1.0625rem) !important;
        line-height: 1.38 !important;
        font-weight: 600 !important;
        letter-spacing: -0.01em !important;
      }

      /* Body elements */
      p, .p, span:not(.material-symbols-outlined):not([class*="fa"]):not([class*="icon"]), li, a, td, th {
        font-family: var(--font-body-family);
      }

      p {
        line-height: 1.65;
        margin-top: 0;
        margin-bottom: 1rem;
      }

      /* Buttons & Navigation */
      button, .button, .btn, a.button, input[type="button"], input[type="submit"],
      .header__menu-item, .nav-link, .header__submenu__title {
        font-family: var(--font-body-family) !important;
        font-weight: 600;
        letter-spacing: 0.02em;
      }

      /* Clean Eyebrows & Overlines */
      .eyebrow, .subheading, .font-label-caps {
        font-family: var(--font-body-family) !important;
        font-size: 0.75rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.12em !important;
        text-transform: uppercase !important;
      }

      @media screen and (max-width: 768px) {
        body {
          font-size: 0.9375rem;
        }
      }

      section.plastic-carpets {
          max-width: 1110px;
          margin: 0 auto;
      }
