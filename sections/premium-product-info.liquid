                        <a href="/products/hybrid-black-red" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'hybrid-black-red' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/black-red.png?v=1714634153'); background-size: cover;" title="Black Red"></a>
                        <a href="/products/indias-first-dual-zone-smart-mat-black-green" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'indias-first-dual-zone-smart-mat-black-green' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/1_13.png?v=1722242611'); background-size: cover;" title="Black Green"></a>
                        <a href="/products/indias-first-dual-zone-smart-mat-black-brown" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'indias-first-dual-zone-smart-mat-black-brown' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/4_5.png?v=1722242611'); background-size: cover;" title="Black Brown"></a>
                      {% elsif product.tags contains 'ulticlean' %}
                        <!-- UltiClean Swatches -->
                        <a href="/products/ulticlean" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'ulticlean' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://6iau9m12oha1q88j-64137167030.shopifypreview.com/cdn/shop/files/product-option-ulticlean-grey-black_120x120.png?v=7435699526537035550'); background-size: cover;" title="Grey"></a>
                        <a href="/products/ulticlean-red-black" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'ulticlean-red-black' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://6iau9m12oha1q88j-64137167030.shopifypreview.com/cdn/shop/files/product-option-ulticlean-red-black_120x120.png?v=11258299124206662848'); background-size: cover;" title="Red"></a>
                        <a href="/products/ultimate-dirt-trap-mat-brown" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'ultimate-dirt-trap-mat-brown' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/3_6.png?v=1722242611'); background-size: cover;" title="Brown"></a>
                        <a href="/products/first-ultimate-dirt-trap-mat-green" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'first-ultimate-dirt-trap-mat-green' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/2_11.png?v=1722242611'); background-size: cover;" title="Green"></a>
                      {% elsif product.tags contains 'ultiScrape' %}
                        <!-- UltiScrape Swatches -->
                        <a href="/products/ultiscrape-1" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'ultiscrape-1' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/product-option-ultiscrape-grey.png'); background-size: cover;" title="Grey"></a>
                        <a href="/products/ultiscrape-3" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'ultiscrape-3' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/product-option-ultiscrape-red.png'); background-size: cover;" title="Red"></a>
                        <a href="/products/ultiscrape-4" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'ultiscrape-4' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/varientbox7.png'); background-size: cover;" title="Brown"></a>
                        <a href="/products/ultiscrape-2" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'ultiscrape-2' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/product-option-ultiscrape-green.png'); background-size: cover;" title="Green"></a>
                      {% elsif product.tags contains 'ultidure' %}
                        <!-- UltiDure Swatches -->
                        <a href="/products/nanotech-toughtread-technology-integrated-commercial-mat-dark-grey" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'nanotech-toughtread-technology-integrated-commercial-mat-dark-grey' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/product-option-ultidure-charcoal.png?v=1751452089'); background-size: cover;" title="Charcoal"></a>
                        <a href="/products/nanotech-toughtread-technology-integrated-commercial-mat-light-grey" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'nanotech-toughtread-technology-integrated-commercial-mat-light-grey' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/LIGHT-GREY.png?v=1723704747'); background-size: cover;" title="Light Grey"></a>
                        <a href="/products/ultidure-high-performance-commercial-mat-burgundy-1" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'ultidure-high-performance-commercial-mat-burgundy-1' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/product-option-ultidure-burgundy.png?v=1751452090'); background-size: cover;" title="Burgundy"></a>
                        <a href="/products/ultidure-high-performance-commercial-mat-brown" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'ultidure-high-performance-commercial-mat-brown' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/product-option-ultidurem2m-brown.png?v=1751452089'); background-size: cover;" title="Brown"></a>
                        <a href="/products/ultidure-high-performance-commercial-mat-hunter-green" class="w-10 h-10 rounded-full transition-all duration-300 ring-offset-1 {% if product.handle == 'ultidure-high-performance-commercial-mat-hunter-green' %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}" style="background-image: url('https://cdn.shopify.com/s/files/1/0641/3716/7030/files/product-option-ultidure-hunter-green.png?v=1751452089'); background-size: cover;" title="Hunter Green"></a>
                      {% endif %}
                    {% else %}
                      <!-- Standard Swatches -->
                      {% for value in option.values %}
                        {%- liquid
                          assign is_active = false
                          if option.selected_value == value
                            assign is_active = true
                          endif
                          
                          # Set dynamic swatches colors
                          assign val_lower = value | downcase
                          assign hex_color = '#191715'
                          if val_lower contains 'grey' or val_lower contains 'gray'
                            assign hex_color = '#4A4A4A'
                          elsif val_lower contains 'silver' or val_lower contains 'light'
                            assign hex_color = '#8E8E8E'
                          elsif val_lower contains 'brown' or val_lower contains 'coco'
                            assign hex_color = '#79573e'
                          elsif val_lower contains 'red'
                            assign hex_color = '#93000a'
                          elsif val_lower contains 'green'
                            assign hex_color = '#444937'
                          endif
                        -%}
                        <button type="button" 
                                class="w-10 h-10 rounded-full transition-all duration-300 option-btn swatch-btn ring-offset-1 {% if is_active %}ring-2 ring-primary ring-offset-2{% else %}ring-1 ring-outline-variant{% endif %}"
                                style="background-color: {{ hex_color }};"
                                data-value="{{ value | escape }}"
                                title="{{ value | escape }}"></button>
                      {% endfor %}
                    {% endif %}
                  </div>
                {% else %}
                  <!-- Render pill-button grid -->
                  <div class="grid grid-cols-3 gap-2 option-buttons-group">
                    {% for value in option.values %}
                      {% assign is_active = false %}
                      {% if option.selected_value == value %}
                        {% assign is_active = true %}
                      {% endif %}
                      <button type="button" 
                              class="border py-3 rounded-md text-xs font-bold tracking-wider font-label-md transition-all duration-300 option-btn {% if is_active %}bg-primary text-on-primary border-primary{% else %}border-outline-variant text-on-surface hover:border-primary{% endif %}"
                              data-value="{{ value | escape }}">
                        {{ value }}
                      </button>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
          </div>
        {% endunless %}
        
        <!-- Pricing Display (Just above Quantity controls) -->
        <div class="flex items-baseline gap-3 my-4" style="display: flex; align-items: baseline; gap: 12px; margin: 24px 0 16px 0;">
          <span id="PremiumPriceDisplay" class="font-display-xl text-headline-md font-normal text-primary" style="font-size: 24px; font-weight: normal; color: #111;">
            {{ current_variant.price | money }}
          </span>
          {% if section.settings.show_vat_text %}
            <span class="text-on-surface-variant text-xs font-semibold uppercase tracking-wider font-label-caps" style="font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.1em; color: #555;">
              Excl. VAT
            </span>
          {% endif %}
        </div>

        <input type="hidden" name="quantity" id="ProductQuantityInput" value="1">

        <!-- Buy Controls Box -->
        <div class="flex flex-col gap-4 pt-4" style="display: flex; flex-direction: column; gap: 16px; padding-top: 16px;">
          <div class="flex gap-4" style="display: flex; gap: 16px; align-items: stretch; width: 100%;">
            <!-- Quantity Control -->
            <div class="flex items-center border border-outline-variant rounded-full px-6 py-2" style="display: flex; align-items: center; border: 1px solid #ccc; border-radius: 999px; overflow: hidden; padding: 0 8px; flex: 0 0 auto;">
              <button type="button" id="QtyDecreaseBtn" class="p-2 text-on-surface-variant hover:text-primary transition-colors focus:outline-none select-none" style="padding: 0 12px; font-size: 18px; font-weight: bold; background: transparent; border: none; cursor: pointer; color: #555; height: 48px; display: flex; align-items: center; justify-content: center;">-</button>
              <span id="QtyDisplay" class="px-5 font-bold text-sm select-none" style="padding: 0 16px; font-weight: bold; font-size: 14px; color: #111; min-width: 24px; text-align: center;">1</span>
              <button type="button" id="QtyIncreaseBtn" class="p-2 text-on-surface-variant hover:text-primary transition-colors focus:outline-none select-none" style="padding: 0 12px; font-size: 18px; font-weight: bold; background: transparent; border: none; cursor: pointer; color: #555; height: 48px; display: flex; align-items: center; justify-content: center;">+</button>
            </div>
            
            <!-- Add To Cart -->
            <button type="submit" 
                    name="add" 
                    id="PremiumAddToCartBtn" 
                    class="flex-1 bg-primary text-on-primary py-5 rounded-full font-bold text-xs uppercase tracking-widest hover:opacity-90 transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed select-none"
                    style="flex: 1; background-color: #000; color: #fff; border: none; border-radius: 999px; height: 48px; font-weight: bold; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; transition: opacity 0.3s; display: flex; align-items: center; justify-content: center;"
                    {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}
                Add to Cart
              {% else %}
                Sold Out
              {% endif %}
            </button>
          </div>
          
          <!-- Buy Now -->
          {% if section.settings.show_buy_now %}
            <button type="button" 
                    id="PremiumBuyNowBtn" 
                    class="w-full bg-secondary text-on-secondary py-5 rounded-full font-bold text-xs uppercase tracking-widest hover:opacity-90 transition-all focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed select-none"
                    style="width: 100%; background-color: #f0f0f0; color: #000; border: 1px solid #ccc; border-radius: 999px; height: 48px; font-weight: bold; font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; cursor: pointer; transition: opacity 0.3s; display: flex; align-items: center; justify-content: center;"
                    {% unless current_variant.available %}disabled{% endunless %}>
              Buy Now
            </button>
          {% endif %}
        </div>
      {%- endform -%}
      
      <!-- Dynamic Tags Badges -->
      {% if product.metafields.product.custom-pills.value != blank %}
        <div style="margin-top: 24px;">
          {{ product.metafields.product.custom-pills.value }}
        </div>
      {% elsif product.tags.size > 0 %}
        <div class="ultimats-pills" style="margin-top: 24px;">
          {% for tag in product.tags %}
            {% assign stripped_tag = tag | strip %}
            {% unless stripped_tag contains '__' or stripped_tag contains 'layout:' or stripped_tag == blank %}
              <p style="display: inline-block; padding: 4px 12px; background: #f5f5f5; border-radius: 999px; font-size: 11px; margin: 0 8px 8px 0; border: 1px solid #e0e0e0;">{{ stripped_tag }}</p>
            {% endunless %}
          {% endfor %}
        </div>
      {% endif %}

      <!-- Reassurances (Color Options, Premium Product, Made in India) -->
      <div class="grid grid-cols-3 gap-2 md:gap-4 border-t border-on-surface/10 pt-8 mt-2 text-center" style="display: flex; flex-direction: row; justify-content: space-between; align-items: flex-start; border-top: 1px solid #eee; padding-top: 32px; margin-top: 24px; text-align: center; gap: 12px;">
        <div class="flex flex-col items-center text-center space-y-2" style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;">
          <span class="material-symbols-outlined text-secondary text-3xl" style="font-size: 28px; color: #555; font-variation-settings: 'FILL' 0, 'wght' 300;">palette</span>
          <div>
            <p class="font-bold text-[10px] md:text-xs uppercase tracking-wider font-label-caps text-primary leading-tight mb-1" style="font-weight: bold; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #111; margin: 0 0 4px 0;">Color Options</p>
            <p class="text-[10px] md:text-[11px] text-on-surface-variant leading-normal" style="font-size: 11px; color: #666; margin: 0; line-height: 1.4;">Choose your mat color</p>
