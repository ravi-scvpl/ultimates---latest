    </div>
  </div>

  <!-- Mobile Product Description Block (Visible on Mobile only, at the bottom of the section) -->
  <div class="block md:hidden prose prose-sm max-w-none mt-8 text-on-surface-variant font-body-md leading-relaxed border-t border-on-surface/10 pt-6 text-left">
    <h3 class="text-lg font-bold text-primary mb-4">Description</h3>
    <p class="mb-6">A premium polyamide all-weather use mat. Traps tracked-in dirt and retains high levels of moisture. This mat is exceptionally durable and versatile, perfect for all seasons. Its reinforced borders and anti-slip nitrile rubber backing provide extra stability and safety. 100% machine-washable at 50C.</p>
    
    <div class="space-y-3 mt-6 text-sm">
      <div><strong class="text-primary font-bold">Material:</strong> Polyamide cut-pile carpet with nitrile rubber backing and reinforced borders</div>
      <div><strong class="text-primary font-bold">Size:</strong> Custom-built to your requirement | Click for Presized Mats</div>
      <div><strong class="text-primary font-bold">Colors:</strong> Dark Grey | Light Grey</div>
      <div><strong class="text-primary font-bold">Application:</strong> Both outdoor and indoor use at all commercial and residential areas</div>
      <div><strong class="text-primary font-bold">Care Instructions:</strong> Dust-off dirt regularly by light tapping or vacuum. Machine-wash at 50C for deep cleaning</div>
    </div>
  </div>
</section>

<!-- Active Variant Selector Logic script -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Gallery Carousel & Thumbnail Interaction via Slick JS
    const thumbs = document.querySelectorAll('.premium-gallery-thumb-wrapper');
    const dots = document.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('PrevGalleryBtn');
    const nextBtn = document.getElementById('NextGalleryBtn');
    const $carousel = $('#PremiumProductImageCarousel');
    
    function updateActiveGalleryItems(activeIndex) {
      thumbs.forEach((thumb, idx) => {
        if (idx === activeIndex) {
          thumb.style.borderColor = '#000000';
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
        } else {
          thumb.style.borderColor = 'transparent';
        }
      });
      
      dots.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.style.backgroundColor = '#000000';
          dot.style.width = '16px';
        } else {
          dot.style.backgroundColor = 'rgba(255,255,255,0.6)';
          dot.style.width = '8px';
        }
      });
    }

    function initSlickCarousel() {
      if (typeof $ !== 'undefined' && $.fn.slick && $carousel.length) {
        if ($carousel.children().length > 1) {
          $carousel.slick({
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: false, // Turn off Slick's arrows so we can bind clicks manually
            dots: false,
            infinite: true,
            fade: false,
            speed: 400,
            adaptiveHeight: true
          });

          // Set initial styles for dots
          updateActiveGalleryItems(0);

          // Manually trigger Prev/Next slide navigation
          $('#PrevGalleryBtn').on('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            $carousel.slick('slickPrev');
          });

          $('#NextGalleryBtn').on('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            $carousel.slick('slickNext');
          });

          $carousel.on('beforeChange', function(event, slick, currentSlide, nextSlide){
            updateActiveGalleryItems(nextSlide);
          });

          // Sync thumbnails click to slick slide control
          thumbs.forEach(thumb => {
            thumb.addEventListener('click', function() {
              const index = parseInt(this.getAttribute('data-thumb-index'), 10);
              $carousel.slick('slickGoTo', index);
            });
          });

          // Sync dots click to slick slide control
          dots.forEach(dot => {
            dot.addEventListener('click', function() {
              const index = parseInt(this.getAttribute('data-index'), 10);
              $carousel.slick('slickGoTo', index);
            });
          });
        }
      } else {
        setTimeout(initSlickCarousel, 50);
      }
    }

    initSlickCarousel();

    // M2M Live Configurator Updates
    const colorMap = {
      'Charcoal Noir': '#1d1b19',
      'Modern Grey': '#7d766f',
      'Crimson Red': '#8b0000',
      'Forest Green': '#1b4d3e',
      'Earth Brown': '#5c4033'
    };

    function updateLivePreview() {
      // 1. Update Sizes
      const widthVal = parseFloat($('#CustomWidthInput').val()) || 24;
      const lengthVal = parseFloat($('#CustomLengthInput').val()) || 48;

      $('#preview-width-label').text('Width: ' + widthVal + '"');
      $('#preview-length-label').text('Length: ' + lengthVal + '"');

      // Linearly map length (48" - 144") to a visual width of 200px - 340px
      const clampedLength = Math.max(48, Math.min(144, lengthVal));
      let pWidth = 200 + ((clampedLength - 48) / (144 - 48)) * 140;

      // Mat height (vertical side) is proportional
      let pHeight = pWidth * (widthVal / lengthVal);

      // Apply size to the mat preview
      $('#side-mat-preview').css({
        width: pWidth + 'px',
        height: pHeight + 'px'
      });

      // Align horizontal arrow (Length) above the mat
      $('#length-arrow-container').css({
        width: pWidth + 'px',
        left: '50%',
        top: 'calc(50% - ' + (pHeight / 2 + 32) + 'px)',
        transform: 'translateX(-50%)'
      });

      // Align vertical arrow (Width) to the left of the mat
      $('#width-arrow-container').css({
        height: pHeight + 'px',
        left: 'calc(50% - ' + (pWidth / 2 + 40) + 'px)',
        top: '50%',
        transform: 'translateY(-50%)'
      });

      // 2. Update Colors
      const activeColor = $('#CustomColorInput').val();
      const colorHex = colorMap[activeColor] || '#1d1b19';
      $('#side-mat-preview').css('background-color', colorHex);

      // 3. Update Borders
      const activeBorder = $('#CustomBordersInput').val();
      if (activeBorder === '4 side borders') {
        $('#side-mat-preview').css('border', '6px solid #000000');
      } else {
        $('#side-mat-preview').css('border', 'none');
      }
    }

    // Bind custom options click events
    $('.color-custom-group').on('click', '.custom-option-btn', function(e) {
      e.preventDefault();
      $('.color-custom-group .custom-option-btn').removeClass('ring-2 ring-primary ring-offset-2').addClass('ring-1 ring-outline-variant');
      $(this).addClass('ring-2 ring-primary ring-offset-2').removeClass('ring-1 ring-outline-variant');
      
      const val = $(this).attr('data-value');
      $('#CustomColorInput').val(val);
      updateLivePreview();
    });

    $('.border-custom-group').on('click', '.custom-option-btn', function(e) {
      e.preventDefault();
      $('.border-custom-group .custom-option-btn').removeClass('bg-primary text-on-primary border-primary').addClass('border-outline-variant text-on-surface hover:border-primary');
      $(this).addClass('bg-primary text-on-primary border-primary').removeClass('border-outline-variant text-on-surface hover:border-primary');
      
      const val = $(this).attr('data-value');
      $('#CustomBordersInput').val(val);
      updateLivePreview();
    });

    // Bind inputs input events
    $('#CustomWidthInput, #CustomLengthInput').on('input change', function() {
      updateLivePreview();
    });

    // Run once on load to initialize preview layout
    setTimeout(updateLivePreview, 100);
    
    // 2. Quantity Interactions
    const qtyDisplay = document.getElementById('QtyDisplay');
    const qtyInput = document.getElementById('ProductQuantityInput');
    const decreaseBtn = document.getElementById('QtyDecreaseBtn');
    const increaseBtn = document.getElementById('QtyIncreaseBtn');
    
    if (decreaseBtn && increaseBtn && qtyDisplay && qtyInput) {
      decreaseBtn.addEventListener('click', function() {
        let currentQty = parseInt(qtyInput.value) || 1;
        if (currentQty > 1) {
          currentQty--;
          qtyInput.value = currentQty;
          qtyDisplay.textContent = currentQty;
          matchSelectedVariant();
        }
      });
      
      increaseBtn.addEventListener('click', function() {
        let currentQty = parseInt(qtyInput.value) || 1;
        currentQty++;
        qtyInput.value = currentQty;
        qtyDisplay.textContent = currentQty;
        matchSelectedVariant();
      });
    }
    
    // 3. Variant Match Logic
    // Load Shopify variants object from JSON
    const variantsData = {{ product.variants | json }};
    
    const optionBtns = document.querySelectorAll('.option-btn');
    const variantIdInput = document.getElementById('ProductVariantId');
    const priceDisplay = document.getElementById('PremiumPriceDisplay');
    const cartBtn = document.getElementById('PremiumAddToCartBtn');
    const buyBtn = document.getElementById('PremiumBuyNowBtn');
    
    optionBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        const parentGroup = this.closest('.option-buttons-group');
        const isSwatch = this.classList.contains('swatch-btn');
        
        // Remove active class from other options in same group
        parentGroup.querySelectorAll('.option-btn').forEach(b => {
          if (isSwatch) {
            b.classList.remove('ring-2', 'ring-primary', 'ring-offset-2');
            b.classList.add('ring-1', 'ring-outline-variant');
          } else {
            b.classList.remove('bg-primary', 'text-on-primary', 'border-primary');
            b.classList.add('border-outline-variant', 'text-on-surface');
          }
        });
        
        // Add active class to selected option button
        if (isSwatch) {
          this.classList.add('ring-2', 'ring-primary', 'ring-offset-2');
          this.classList.remove('ring-1', 'ring-outline-variant');
        } else {
          this.classList.add('bg-primary', 'text-on-primary', 'border-primary');
          this.classList.remove('border-outline-variant', 'text-on-surface');
        }
        
        // Find matching variant based on current options selected
        matchSelectedVariant();
      });
    });
    
    function matchSelectedVariant() {
      const isM2M = {{ is_m2m | json }};
      let matchedVariant = null;
      
      if (isM2M) {
        // M2M Variant Selection based on Width & Length
        const widthInput = document.getElementById('CustomWidthInput');
        const lengthInput = document.getElementById('CustomLengthInput');
        if (widthInput && lengthInput) {
          const exactWVal = parseInt(widthInput.value, 10) || 24;
          const exactLVal = parseInt(lengthInput.value, 10) || 48;
          
          const standardWidths = [24, 36, 48];
          const standardLengths = [48, 54, 60, 66, 72, 78, 84, 90, 96, 102, 108, 114, 120, 126, 132, 138, 144];
          
          function getNearestM2M(val, list) {
            let matched = list.find(item => item >= val);
            if (!matched) matched = list[list.length - 1];
            return matched;
          }
          
          const chargeableW = getNearestM2M(exactWVal, standardWidths);
          const chargeableL = getNearestM2M(exactLVal, standardLengths);
          
          const targetWStr = chargeableW + '"';
          const targetLStr = chargeableL + '"';
          
          matchedVariant = variantsData.find(variant => {
            const opt1 = (variant.option1 || '').trim();
            const opt2 = (variant.option2 || '').trim();
            
            return (opt1 === targetWStr && opt2 === targetLStr) || (opt1 === targetLStr && opt2 === targetWStr) ||
                   (opt1 === chargeableW.toString() && opt2 === chargeableL.toString()) || (opt1 === chargeableL.toString() && opt2 === chargeableW.toString());
          });
        }
      } else {
        // Standard Option matching
        const selectedOptions = [];
        const optionWrappers = document.querySelectorAll('.option-selector-wrapper');
        
        optionWrappers.forEach(wrapper => {
          const activeBtn = wrapper.querySelector('.ring-2') || wrapper.querySelector('.bg-primary');
          if (activeBtn) {
            selectedOptions.push(activeBtn.getAttribute('data-value'));
          }
        });
        
        if (selectedOptions.length > 0 && variantsData) {
          matchedVariant = variantsData.find(variant => {
            let match = true;
            for (let i = 0; i < selectedOptions.length; i++) {
              const optIndex = 'option' + (i + 1);
              if (variant[optIndex] !== selectedOptions[i]) {
                match = false;
                break;
              }
            }
            return match;
          });
        }
      }
      
      if (matchedVariant) {
        // Update input ID
        variantIdInput.value = matchedVariant.id;
        
        // Update Price with quantity multiplier
        const qty = parseInt(document.getElementById('ProductQuantityInput').value) || 1;
        const totalPrice = matchedVariant.price * qty;
        const formattedPrice = formatShopifyMoney(totalPrice);
        priceDisplay.textContent = formattedPrice;
        
        // Update Add to Cart / Buy Now buttons availability
        if (matchedVariant.available) {
          cartBtn.removeAttribute('disabled');
          cartBtn.textContent = 'Add to Cart';
          if (buyBtn) {
            buyBtn.removeAttribute('disabled');
          }
        } else {
          cartBtn.setAttribute('disabled', 'disabled');
          cartBtn.textContent = 'Sold Out';
          if (buyBtn) {
            buyBtn.setAttribute('disabled', 'disabled');
          }
        }
      } else {
        // No match found
        cartBtn.setAttribute('disabled', 'disabled');
        cartBtn.textContent = 'Unavailable';
        if (buyBtn) {
          buyBtn.setAttribute('disabled', 'disabled');
        }
      }
    }

    // Attach event listeners to M2M inputs to trigger price updating dynamically
    const widthInputEl = document.getElementById('CustomWidthInput');
    const lengthInputEl = document.getElementById('CustomLengthInput');
    if (widthInputEl && lengthInputEl) {
      widthInputEl.addEventListener('input', matchSelectedVariant);
      lengthInputEl.addEventListener('input', matchSelectedVariant);
    }

    // Execute immediately to calculate default initial pricing
    setTimeout(matchSelectedVariant, 300);
    
    // Quick helper to format money dynamically
    function formatShopifyMoney(cents) {
      const value = (cents / 100).toFixed(2);
      // Determine currency sign (default to British pound as in mockup)
      const currencySign = '{{ cart.currency.symbol }}' || '£';
      return currencySign + value;
    }
    
    // Quick checkout Buy Now action
    if (buyBtn) {
      buyBtn.addEventListener('click', function() {
        const varId = variantIdInput.value;
        const qty = qtyInput.value;
        if (varId) {
          // Dynamic checkout URL redirect
          window.location.href = `/cart/${varId}:${qty}`;
        }
      });
    }
  });
</script>

<style>
