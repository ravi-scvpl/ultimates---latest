          <span class="material-symbols-outlined text-secondary text-3xl" style="font-size: 28px; color: #555; font-variation-settings: 'FILL' 0, 'wght' 300;">public</span>
          <div>
            <p class="font-bold text-[10px] md:text-xs uppercase tracking-wider font-label-caps text-primary leading-tight mb-1" style="font-weight: bold; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #111; margin: 0 0 4px 0;">Made in India</p>
            <p class="text-[10px] md:text-[11px] text-on-surface-variant leading-normal" style="font-size: 11px; color: #666; margin: 0; line-height: 1.4;">Exported worldwide</p>
