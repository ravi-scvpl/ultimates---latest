          <div>
            <p class="font-bold text-[10px] md:text-xs uppercase tracking-wider font-label-caps text-primary leading-tight mb-1" style="font-weight: bold; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: #111; margin: 0 0 4px 0;">Premium Product</p>
            <p class="text-[10px] md:text-[11px] text-on-surface-variant leading-normal" style="font-size: 11px; color: #666; margin: 0; line-height: 1.4;">High-quality materials & finishing</p>
