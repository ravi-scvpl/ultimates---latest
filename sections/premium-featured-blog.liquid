{%- style -%}
  #premium-featured-blog-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#fdf9f1' }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="premium-featured-blog-{{ section.id }}" class="relative w-full z-10 font-body-md text-on-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    
    <!-- Section Header -->
    {% if section.settings.title != blank or section.settings.subheading != blank %}
      <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 space-y-4">
        {% if section.settings.title != blank %}
          <h2 class="font-display-xl text-4xl lg:text-6xl font-normal leading-tight text-primary">
            {{ section.settings.title }}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="text-on-surface-variant font-body-lg text-base lg:text-lg leading-relaxed">
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Blog Posts Grid -->
    {%- assign blog = blogs[section.settings.blog] -%}
    {%- assign limit = section.settings.limit | default: 3 -%}
    
    {% if blog != blank and blog.articles_count > 0 %}
      <div class="grid grid-cols-1 md:grid-cols-{{ section.settings.columns_desktop | default: 3 }} gap-8 items-stretch">
        {% for article in blog.articles limit: limit %}
          <article class="group flex flex-col h-full bg-surface-container-low rounded-lg overflow-hidden border border-outline-variant/30 custom-shadow hover:scale-[1.01] hover:border-secondary/40 transition-all duration-300">
            <!-- Featured Image -->
            <a href="{{ article.url }}" class="block aspect-[16/10] w-full overflow-hidden relative">
              {% if article.image != blank %}
                <img 
                  src="{{ article.image | image_url: width: 800 }}" 
                  alt="{{ article.title | escape }}"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover bg-surface-container-high' }}
              {% endif %}
            </a>

            <!-- Content -->
            <div class="p-6 flex flex-col flex-1 text-left space-y-3">
              <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider block">
                {{ article.published_at | time_tag: format: 'date' }}
              </span>

              <h3 class="font-headline-md text-xl md:text-2xl text-primary font-normal leading-snug hover:text-secondary transition-colors duration-300">
                <a href="{{ article.url }}" class="block">
                  {{ article.title }}
                </a>
              </h3>

              {% if section.settings.show_excerpt %}
                <p class="font-body-md text-sm text-on-surface-variant leading-relaxed line-clamp-3 flex-1">
                  {% if article.excerpt.size > 0 %}
                    {{ article.excerpt | strip_html | truncatewords: 25 }}
                  {% else %}
                    {{ article.content | strip_html | truncatewords: 25 }}
                  {% endif %}
                </p>
              {% else %}
                <div class="flex-1"></div>
              {% endif %}

              <div class="pt-4">
                <a href="{{ article.url }}" class="inline-flex items-center text-secondary font-label-caps text-xs tracking-wider uppercase border-b border-transparent hover:border-secondary transition-all duration-300">
                  Read Article
                  <span class="material-symbols-outlined ml-1 text-sm transition-transform duration-300 group-hover:translate-x-1" style="font-size: 14px;">arrow_forward</span>
                </a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      <!-- View All Button -->
      {% if section.settings.show_view_all %}
        <div class="text-center mt-12 md:mt-16">
          <a href="{{ blog.url }}" class="inline-block px-8 py-3 bg-primary text-on-primary font-label-caps uppercase tracking-wider rounded hover:bg-secondary hover:text-white transition-all duration-300">
            View All Posts
          </a>
        </div>
      {% endif %}

    {% else %}
      <!-- Onboarding state if no blog matches -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {% for i in (1..3) %}
          <div class="group flex flex-col h-full bg-surface-container-low rounded-lg overflow-hidden border border-outline-variant/30 custom-shadow">
            <div class="aspect-[16/10] w-full bg-surface-container-highest"></div>
            <div class="p-6 flex flex-col flex-1 text-left space-y-3">
              <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider block">June 8, 2026</span>
              <h3 class="font-headline-md text-xl text-primary font-normal leading-snug">Sample Blog Post Title</h3>
              <p class="font-body-md text-sm text-on-surface-variant leading-relaxed">This is sample text showing where your blog post excerpt will appear. Connect a blog to display posts.</p>
              <div class="pt-4">
                <span class="inline-flex items-center text-secondary font-label-caps text-xs tracking-wider uppercase">Read Article <span class="material-symbols-outlined ml-1" style="font-size: 14px;">arrow_forward</span></span>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Premium Featured Blog",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf9f1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Latest from our blog"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Insights, stories, and design inspiration from the Ultimats team."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 3,
      "max": 9,
      "step": 3,
      "label": "Number of posts to show",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on Desktop",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Premium Featured Blog",
      "settings": {
        "blog": "news"
      }
    }
  ]
}
{% endschema %}
