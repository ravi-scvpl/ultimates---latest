{%- style -%}
  #premium-blog-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FAF8F5' }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .blog-card {
    background-color: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .blog-card:hover {
    transform: translateY(-2px);
    border-color: rgba(0, 0, 0, 0.1);
  }
  .read-more-link {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #000000;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.2s ease;
  }
  .read-more-link:hover {
    opacity: 0.7;
  }
{%- endstyle -%}

<section id="premium-blog-{{ section.id }}" class="relative w-full z-10 font-body-md text-on-surface">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    
    <!-- Section Header -->
    <div class="text-left max-w-4xl mb-12">
      <p class="text-xs tracking-widest uppercase text-[#8C6D4F] font-bold mb-3">Ultimats Insights</p>
      <h1 class="text-5xl md:text-6xl font-normal leading-tight mb-4 text-black" style="font-family: 'Playfair Display', serif;">
        Blogs
      </h1>
      <div class="h-1 w-20 bg-black mt-6"></div>
    </div>

    <!-- Featured Hero Card (First Article) -->
    {% if blog.articles.size > 0 %}
      {% assign first_article = blog.articles.first %}
      <div class="mb-12">
        <article class="group grid grid-cols-1 lg:grid-cols-12 gap-0 items-stretch blog-card">
          <a href="{{ first_article.url }}" class="lg:col-span-7 block aspect-[16/9] lg:aspect-auto lg:h-[450px] w-full overflow-hidden relative">
            {% if first_article.image != blank %}
              <img 
                src="{{ first_article.image | image_url: width: 1200 }}" 
                alt="{{ first_article.title | escape }}" 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-102" 
                loading="lazy"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover bg-neutral-100' }}
            {% endif %}
          </a>
          <div class="lg:col-span-5 p-8 lg:p-12 text-left flex flex-col space-y-4 justify-center bg-white">
            <span class="text-xs font-bold text-neutral-500 uppercase tracking-widest block">Featured • {{ first_article.published_at | time_tag: format: 'date' }}</span>
            <h2 class="text-2xl lg:text-3xl text-black font-normal leading-tight hover:opacity-80 transition-opacity" style="font-family: 'Playfair Display', serif;">
              <a href="{{ first_article.url }}">{{ first_article.title }}</a>
            </h2>
            <p class="text-neutral-600 leading-relaxed text-sm">
              {% if first_article.excerpt.size > 0 %}
                {{ first_article.excerpt | strip_html | truncatewords: 30 }}
              {% else %}
                {{ first_article.content | strip_html | truncatewords: 30 }}
              {% endif %}
            </p>
            <div class="pt-4">
              <a href="{{ first_article.url }}" class="read-more-link">
                Read Featured Article
                <span class="ml-2 font-bold">&rarr;</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    {% endif %}

    <!-- Paginated Remaining Articles Grid -->
    {% paginate blog.articles by section.settings.limit %}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {% for article in blog.articles offset: 1 %}
          <article class="group flex flex-col h-full blog-card">
            <a href="{{ article.url }}" class="block aspect-[16/10] w-full overflow-hidden relative">
              {% if article.image != blank %}
                <img 
                  src="{{ article.image | image_url: width: 800 }}" 
                  alt="{{ article.title | escape }}" 
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                  loading="lazy"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover bg-neutral-100' }}
              {% endif %}
            </a>
            <div class="p-6 flex flex-col flex-1 text-left space-y-3 bg-white">
              <span class="text-xs font-bold text-[#8C6D4F] uppercase tracking-widest block">{{ article.published_at | time_tag: format: 'date' }}</span>
              <h3 class="text-xl text-black font-normal leading-snug hover:opacity-80 transition-opacity" style="font-family: 'Playfair Display', serif;">
                <a href="{{ article.url }}" class="block">{{ article.title }}</a>
              </h3>
              {% if section.settings.show_excerpt %}
                <p class="text-sm text-neutral-600 leading-relaxed line-clamp-3 flex-1">
                  {% if article.excerpt.size > 0 %}
                    {{ article.excerpt | strip_html | truncatewords: 20 }}
                  {% else %}
                    {{ article.content | strip_html | truncatewords: 20 }}
                  {% endif %}
                </p>
              {% else %}
                <div class="flex-1"></div>
              {% endif %}
              <div class="pt-4">
                <a href="{{ article.url }}" class="read-more-link">
                  Read Article
                  <span class="ml-2 font-bold">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      <!-- Paginate Navigation -->
      {% if paginate.pages > 1 %}
        <div class="mt-16 flex justify-center items-center space-x-3">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="px-6 py-2 border border-primary text-primary rounded-full hover:bg-primary hover:text-white transition-all text-xs font-semibold font-label-caps uppercase">&larr; Prev</a>
          {% endif %}
          
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="w-10 h-10 flex items-center justify-center border border-outline-variant rounded-full hover:bg-primary hover:text-white transition-all text-sm font-semibold">{{ part.title }}</a>
            {% else %}
              <span class="w-10 h-10 flex items-center justify-center rounded-full bg-primary text-white text-sm font-semibold">{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="px-6 py-2 border border-primary text-primary rounded-full hover:bg-primary hover:text-white transition-all text-xs font-semibold font-label-caps uppercase">Next &rarr;</a>
          {% endif %}
        </div>
      {% endif %}
    {% endpaginate %}

  </div>
</section>

{% schema %}
{
  "name": "Premium Main Blog",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf9f1"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 13,
      "step": 3,
      "label": "Posts Per Page",
      "default": 7
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show Excerpt",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ]
}
{% endschema %}
