{%- style -%}
  #premium-media-grid-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color | default: '#fdf9f1' }};
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  
  {%- for block in section.blocks -%}
    @media screen and (max-width: 767px) {
      .premium-grid-item-{{ block.id }} {
        grid-column: span 1 / span 1 !important;
        grid-row: span 1 / span 1 !important;
      }
    }
    @media screen and (min-width: 768px) {
      .premium-grid-item-{{ block.id }} {
        grid-column: span {{ block.settings.item_width }} / span {{ block.settings.item_width }} !important;
        grid-row: span {{ block.settings.item_height }} / span {{ block.settings.item_height }} !important;
      }
    }
  {%- endfor -%}
{%- endstyle -%}

<section id="premium-media-grid-{{ section.id }}" class="relative w-full z-10 font-body-md text-on-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    
    <!-- Section Header -->
    {% if section.settings.title != blank or section.settings.text != blank %}
      <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16 space-y-4">
        {% if section.settings.title != blank %}
          <h2 class="font-display-xl text-4xl lg:text-6xl font-normal leading-tight text-primary">
            {{ section.settings.title }}
          </h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <p class="text-on-surface-variant font-body-lg text-base lg:text-lg leading-relaxed">
            {{ section.settings.text }}
          </p>
        {% endif %}
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <div class="pt-4">
            <a href="{{ section.settings.button_link }}" class="inline-block px-8 py-3 bg-primary text-on-primary font-label-caps uppercase tracking-wider rounded hover:bg-secondary hover:text-white transition-all duration-300">
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <!-- Media Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 auto-rows-[250px] md:auto-rows-[{{ section.settings.row_height | default: 170 }}px]">
      {% for block in section.blocks %}
        <div 
          class="premium-grid-item-{{ block.id }} group relative overflow-hidden rounded-lg custom-shadow"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="block w-full h-full">
          {% else %}
            <div class="w-full h-full">
          {% endif %}

          <!-- Media Source -->
          <div class="absolute inset-0 w-full h-full overflow-hidden">
            {% if block.settings.video != blank %}
              {% liquid
                if block.settings.autoplay_video
                  assign playsinline = true
                  assign loop = true
                  assign autoplay = true
                  assign muted = true
                  assign controls = false
                else
                  assign playsinline = true
                  assign loop = false
                  assign autoplay = false
                  assign muted = false
                  assign controls = true
                endif
              %}
              {{ block.settings.video | video_tag: class: 'w-full h-full object-cover transition-transform duration-700 group-hover:scale-105', autoplay: autoplay, loop: loop, muted: muted, playsinline: playsinline, controls: controls }}
            {% elsif block.settings.image != blank %}
              <img 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                src="{{ block.settings.image | image_url: width: 1200 }}" 
                alt="{{ block.settings.title | default: section.settings.title | escape }}"
                loading="lazy"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover bg-surface-container-high' }}
            {% endif %}
          </div>

          <!-- Overlay and text content -->
          {%- liquid 
            assign text_position_class = "justify-end items-start text-left"
            case section.settings.text_position
              when "top-left"
                assign text_position_class = "justify-start items-start text-left"
              when "top-center"
                assign text_position_class = "justify-start items-center text-center"
              when "top-right"
                assign text_position_class = "justify-start items-end text-right"
              when "center"
                assign text_position_class = "justify-center items-center text-center"
              when "bottom-left"
                assign text_position_class = "justify-end items-start text-left"
              when "bottom-center"
                assign text_position_class = "justify-end items-center text-center"
              when "bottom-right"
                assign text_position_class = "justify-end items-end text-right"
            endcase
          -%}

          {%- assign scrim_opacity = 0.45 -%}
          {%- if block.settings.show_scrim -%}
            {%- assign scrim_opacity = block.settings.scrim_lightness | divided_by: 255.0 | min: 1.0 -%}
          {%- endif -%}

          <div 
            class="absolute inset-0 z-10 flex flex-col p-6 transition-all duration-300 {{ text_position_class }} bg-gradient-to-t from-black/85 via-black/30 to-transparent"
            {% if block.settings.show_scrim %}
              style="background: linear-gradient(to top, rgba(0,0,0,{{ scrim_opacity | plus: 0.35 | at_most: 0.95 }}) 0%, rgba(0,0,0,{{ scrim_opacity | times: 0.5 }}) 50%, rgba(0,0,0,0) 100%);"
            {% endif %}
          >
            <div class="transform {% if section.settings.title_on_hover %}translate-y-4 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300{% endif %}">
              {% if block.settings.title != blank %}
                <h3 class="font-headline-md text-white font-medium text-lg md:text-xl tracking-wide">
                  {{ block.settings.title }}
                </h3>
              {% endif %}
              
              {%- liquid
                assign desc_class = ""
                if section.settings.description_on_hover
                  assign desc_class = "opacity-0 group-hover:opacity-100 max-h-0 group-hover:max-h-20 transition-all duration-500 overflow-hidden"
                endif
              -%}
              {% if block.settings.text != blank %}
                <p class="font-body-md text-white/90 text-xs md:text-sm mt-1 leading-relaxed {{ desc_class }}">
                  {{ block.settings.text }}
                </p>
              {% endif %}
            </div>
          </div>

          {% if block.settings.link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Premium Media Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf9f1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Subheading",
      "default": "All Terrain Premium Commercial Floor Mats"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "row_height",
      "min": 150,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Row Height (Desktop)",
      "default": 170
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Overlay Position",
      "options": [
        {
          "value": "top-left",
          "label": "Top Left"
        },
        {
          "value": "top-center",
          "label": "Top Center"
        },
        {
          "value": "top-right",
          "label": "Top Right"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom Center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        }
      ],
      "default": "bottom-left"
    },
    {
      "type": "checkbox",
      "id": "title_on_hover",
      "label": "Hide title until hover",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "description_on_hover",
      "label": "Hide description until hover",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 44
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Media Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "checkbox",
          "id": "autoplay_video",
          "default": true,
          "label": "Autoplay Video"
        },
        {
          "type": "range",
          "id": "item_width",
          "min": 1,
          "max": 4,
          "label": "Column Span",
          "default": 1
        },
        {
          "type": "range",
          "id": "item_height",
          "min": 1,
          "max": 4,
          "label": "Row Span",
          "default": 1
        },
        {
          "type": "checkbox",
          "id": "show_scrim",
          "default": true,
          "label": "Show Overlay Scrim"
        },
        {
          "type": "range",
          "id": "scrim_lightness",
          "min": 0,
          "max": 255,
          "step": 15,
          "default": 0,
          "label": "Scrim Density",
          "info": "0 is transparent/light, 255 is dark shadow overlay"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Media Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Add description text."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Media Grid",
      "blocks": [
        {
          "type": "media",
          "settings": {
            "item_width": 2,
            "item_height": 2
          }
        },
        {
          "type": "media",
          "settings": {
            "item_width": 1,
            "item_height": 1
          }
        },
        {
          "type": "media",
          "settings": {
            "item_width": 1,
            "item_height": 1
          }
        }
      ]
    }
  ]
}
{% endschema %}
