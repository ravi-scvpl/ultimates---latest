<!-- Premium Application Environments / Where to Use Section -->
<section class="bg-surface-container py-16 md:py-24 relative z-10 font-body-md text-on-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop text-center">
    
    {% if section.settings.subheading != blank %}
      <p class="font-label-caps uppercase text-secondary text-xs font-bold mb-6 tracking-[0.2em] select-none">
        {{ section.settings.subheading }}
      </p>
    {% endif %}
    
    {% if section.settings.heading != blank %}
      <h2 class="font-display-xl text-headline-lg font-normal leading-tight text-primary mb-12">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
    
    {% if section.settings.tags != blank %}
      <div class="flex flex-wrap justify-center gap-4 max-w-4xl mx-auto">
        {% assign tags_array = section.settings.tags | split: ',' %}
        {% for tag in tags_array %}
          {% assign clean_tag = tag | strip %}
          {% if clean_tag != blank %}
            {% if forloop.first %}
              <span class="bg-primary text-on-primary px-8 py-3 rounded-full font-bold text-xs uppercase tracking-wider font-label-caps select-none shadow-sm">
                {{ clean_tag }}
              </span>
            {% else %}
              <span class="border border-outline px-8 py-3 rounded-full font-bold text-xs uppercase tracking-wider font-label-caps select-none transition-all duration-300 hover:bg-primary hover:text-on-primary hover:border-primary cursor-pointer hover:scale-105 hover:shadow-sm">
                {{ clean_tag }}
              </span>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    
  </div>
</section>

{% schema %}
{
  "name": "Premium Environments",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Where Architectural Quality Matters"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Application Environments"
    },
    {
      "type": "textarea",
      "id": "tags",
      "label": "Tags (comma-separated list)",
      "default": "Apartment Entrance, Hotel Lobby, Retail Space, Corporate Office, Museum Gallery",
      "info": "The first tag will be styled in solid/dark format by default."
    }
  ],
  "presets": [
    {
      "name": "Premium Environments",
      "category": "Product"
    }
  ]
}
{% endschema %}
