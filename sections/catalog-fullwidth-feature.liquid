<style>
  #FullwidthFeature-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    box-sizing: border-box;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_bg_color }};
  }

  /* Overlay Mode (Full Background Image) */
  .fullwidth-feature-banner {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.desktop_height }};
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .fullwidth-feature-bg-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .fullwidth-feature-bg-media img,
  .fullwidth-feature-bg-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .fullwidth-feature-bg-media .desktop-img {
    display: block;
  }
  .fullwidth-feature-bg-media .mobile-img {
    display: none;
  }

  .fullwidth-feature-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .fullwidth-feature-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px 24px;
    display: flex;
    box-sizing: border-box;
    {% case section.settings.card_position %}
      {% when 'left' %}
        justify-content: flex-start;
      {% when 'center' %}
        justify-content: center;
      {% when 'right' %}
        justify-content: flex-end;
    {% endcase %}
  }

  .fullwidth-feature-card {
    width: 100%;
    max-width: {{ section.settings.card_max_width }}px;
    padding: {{ section.settings.card_padding }}px;
    border-radius: {{ section.settings.card_border_radius }}px;
    box-sizing: border-box;
    text-align: {{ section.settings.text_alignment }};
    transition: all 0.3s ease;

    {% if section.settings.enable_glassmorphism %}
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    {% elsif section.settings.card_bg_color != blank and section.settings.card_bg_color != 'transparent' %}
      background-color: {{ section.settings.card_bg_color }};
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
    {% else %}
      background: transparent;
    {% endif %}
  }

  .fullwidth-feature-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.badge_color }};
    margin-bottom: 12px;
  }

  .fullwidth-feature-heading {
    margin: 0 0 16px 0;
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    font-family: var(--font-heading-family, inherit);
    line-height: 1.25;
    font-weight: 700;
    word-break: break-word;
  }

  .fullwidth-feature-desc {
    margin: 0 0 24px 0;
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    line-height: 1.6;
  }

  .fullwidth-feature-desc p {
    margin: 0 0 12px 0;
    color: inherit;
  }

  .fullwidth-feature-desc p:last-child {
    margin-bottom: 0;
  }

  .fullwidth-feature-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.3s ease;
    cursor: pointer;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    border: 1px solid {{ section.settings.button_border_color }};
  }

  .fullwidth-feature-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  /* Split 50/50 Mode */
  .fullwidth-feature-split {
    display: flex;
    width: 100%;
    min-height: {{ section.settings.desktop_height }};
    align-items: stretch;
  }

  .fullwidth-feature-split-image {
    flex: 1;
    position: relative;
    min-height: 400px;
  }

  .fullwidth-feature-split-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fullwidth-feature-split-content {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 5%;
    box-sizing: border-box;
    background-color: {{ section.settings.card_bg_color }};
  }

  @media screen and (max-width: 989px) {
    .fullwidth-feature-banner {
      min-height: {{ section.settings.mobile_height }};
    }

    {% if section.settings.mobile_image != blank %}
      .fullwidth-feature-bg-media .desktop-img {
        display: none;
      }
      .fullwidth-feature-bg-media .mobile-img {
        display: block;
      }
    {% endif %}

    .fullwidth-feature-container {
      padding: 24px 16px;
      justify-content: center;
    }

    .fullwidth-feature-card {
      max-width: 100%;
      padding: 24px 20px;
      text-align: {{ section.settings.mobile_text_alignment }};
    }

    .fullwidth-feature-heading {
      font-size: {{ section.settings.heading_size | times: 0.8 | round }}px;
    }

    .fullwidth-feature-desc {
      font-size: {{ section.settings.description_size | times: 0.9 | round }}px;
    }

    .fullwidth-feature-split {
      flex-direction: column;
    }

    .fullwidth-feature-split-image {
      min-height: 300px;
    }

    .fullwidth-feature-split-content {
      padding: 40px 20px;
    }
  }
</style>

<section id="FullwidthFeature-{{ section.id }}">
  {% if section.settings.layout_mode == 'overlay' %}
    <div class="fullwidth-feature-banner">
      <div class="fullwidth-feature-bg-media">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 2200 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            class="desktop-img"
          >
          {% if section.settings.mobile_image != blank %}
            <img
              src="{{ section.settings.mobile_image | image_url: width: 1000 }}"
              alt="{{ section.settings.heading | escape }}"
              loading="lazy"
              class="mobile-img"
            >
          {% else %}
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              alt="{{ section.settings.heading | escape }}"
              loading="lazy"
              class="mobile-img"
            >
          {% endif %}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>

      <div class="fullwidth-feature-overlay"></div>

      <div class="fullwidth-feature-container">
        <div class="fullwidth-feature-card">
          {% if section.settings.badge != blank %}
            <span class="fullwidth-feature-badge">{{ section.settings.badge }}</span>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="fullwidth-feature-heading">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.description != blank %}
            <div class="fullwidth-feature-desc">{{ section.settings.description }}</div>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link | default: '#' }}" class="fullwidth-feature-btn">
              {{ section.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  {% else %}
    <!-- Split Layout Mode -->
    <div class="fullwidth-feature-split">
      {% capture media_block %}
        <div class="fullwidth-feature-split-image">
          {% if section.settings.image != blank %}
            <img
              src="{{ section.settings.image | image_url: width: 1400 }}"
              alt="{{ section.settings.heading | escape }}"
              loading="lazy"
            >
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      {% endcapture %}

      {% capture content_block %}
        <div class="fullwidth-feature-split-content">
          <div class="fullwidth-feature-card" style="max-width: {{ section.settings.card_max_width }}px;">
            {% if section.settings.badge != blank %}
              <span class="fullwidth-feature-badge">{{ section.settings.badge }}</span>
            {% endif %}

            {% if section.settings.heading != blank %}
              <h2 class="fullwidth-feature-heading">{{ section.settings.heading }}</h2>
            {% endif %}

            {% if section.settings.description != blank %}
              <div class="fullwidth-feature-desc">{{ section.settings.description }}</div>
            {% endif %}

            {% if section.settings.button_label != blank %}
              <a href="{{ section.settings.button_link | default: '#' }}" class="fullwidth-feature-btn">
                {{ section.settings.button_label }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endcapture %}

      {% if section.settings.image_position == 'left' %}
        {{ media_block }}
        {{ content_block }}
      {% else %}
        {{ content_block }}
        {{ media_block }}
      {% endif %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Full Width Feature",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout Style"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout Mode",
      "default": "overlay",
      "options": [
        { "value": "overlay", "label": "Full Background Image with Overlay Card" },
        { "value": "split", "label": "Full Width 50/50 Split (Image + Content)" }
      ]
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position (Split Mode Only)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Image Left, Content Right" },
        { "value": "right", "label": "Content Left, Image Right" }
      ]
    },
    {
      "type": "select",
      "id": "desktop_height",
      "label": "Desktop Min Height",
      "default": "550px",
      "options": [
        { "value": "100vh", "label": "Full Screen (100vh)" },
        { "value": "700px", "label": "Extra Large (700px)" },
        { "value": "550px", "label": "Large (550px)" },
        { "value": "450px", "label": "Medium (450px)" },
        { "value": "350px", "label": "Small (350px)" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Mobile Min Height",
      "default": "400px",
      "options": [
        { "value": "100vh", "label": "Full Screen (100vh)" },
        { "value": "500px", "label": "Large (500px)" },
        { "value": "400px", "label": "Medium (400px)" },
        { "value": "300px", "label": "Small (300px)" }
      ]
    },
    {
      "type": "header",
      "content": "Images & Overlay"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image (100% Width)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Background Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content Box & Card Styling"
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "Card Horizontal Alignment (Overlay Mode)",
      "default": "right",
      "options": [
        { "value": "left", "label": "Left Aligned" },
        { "value": "center", "label": "Center Aligned" },
        { "value": "right", "label": "Right Aligned" }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Mobile Text Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "card_max_width",
      "min": 350,
      "max": 900,
      "step": 25,
      "unit": "px",
      "label": "Card Max Width",
      "default": 550
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Card Inner Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 16
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "checkbox",
      "id": "enable_glassmorphism",
      "label": "Enable Frosted Glass Effect (Glassmorphism)",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography & Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Sub-badge / Small Tag",
      "default": "PRODUCT HIGHLIGHT"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#555555"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "ULTISCRUB CARPET MATTING"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Small Description",
      "default": "<p>Polypropylene looped pile dual stiffness fiber commercial matting with tough vinyl backing and all-around compressed borders.</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 15
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#444444"
    },
    {
      "type": "header",
      "content": "Button / Link (Optional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Configure Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Section Colors & Padding"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Outer Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Full Width Feature Section",
      "settings": {
        "heading": "ULTISCRUB CARPET MATTING",
        "description": "<p>Polypropylene looped pile dual stiffness fiber commercial matting with tough vinyl backing and all-around compressed borders.</p>",
        "button_label": "Configure Now"
      }
    }
  ]
}
{% endschema %}
