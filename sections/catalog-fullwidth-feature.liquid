      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 15
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#444444"
    },
    {
      "type": "header",
      "content": "Button / Link (Optional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Configure Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button Border Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Section Colors & Padding"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Outer Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Full Width Feature Section",
      "settings": {
        "heading": "ULTISCRUB CARPET MATTING",
        "description": "<p>Polypropylene looped pile dual stiffness fiber commercial matting with tough vinyl backing and all-around compressed borders.</p>",
        "button_label": "Configure Now"
      }
    }
  ]
}
{% endschema %}
