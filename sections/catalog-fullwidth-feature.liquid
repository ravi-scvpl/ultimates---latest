    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card Corner Radius",
      "default": 16
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "checkbox",
      "id": "enable_glassmorphism",
      "label": "Enable Frosted Glass Effect (Glassmorphism)",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography & Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Sub-badge / Small Tag",
      "default": "PRODUCT HIGHLIGHT"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#555555"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "ULTISCRUB CARPET MATTING"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Small Description",
