<!-- Premium Commercial Bento Grid -->
<section
  id="premium-commercial-bento-{{ section.id }}"
  class="px-margin-mobile md:px-margin-desktop py-20 md:py-28 relative z-10 bg-surface-container-low"
  style="background-color: {{ section.settings.bg_color | default: '#f7f3eb' }};"
>
  <div class="max-w-container-max mx-auto">
    <!-- Header -->
    <div class="mb-16 text-center space-y-4">
      {% if section.settings.heading != blank %}
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      
      {% if section.settings.subheading != blank %}
        <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
          {{ section.settings.subheading }}
        </p>
      {% endif %}
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {% for block in section.blocks %}
        {% assign col_span = block.settings.col_span %}
        {% assign aspect_class = "" %}
        
        {% if col_span == '4' %}
          {% assign aspect_class = "aspect-square" %}
        {% else %}
          {% if forloop.index == 1 %}
            {% assign aspect_class = "aspect-video md:aspect-auto md:h-[500px]" %}
          {% else %}
            {% assign aspect_class = "aspect-video md:aspect-auto md:h-[400px]" %}
          {% endif %}
        {% endif %}
        
        <div
          class="md:col-span-{{ col_span }} group relative overflow-hidden rounded-lg {{ aspect_class }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            <img
              alt="{{ block.settings.title | escape }}"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              src="{{ block.settings.image | image_url: width: 1200 }}"
              loading="lazy"
            >
          {% else %}
            <img
              alt="{{ block.settings.title | escape }}"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              src="{{ block.settings.fallback_image_url }}"
              loading="lazy"
            >
          {% endif %}
          
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent flex flex-col justify-end p-8 md:p-10 text-left">
            <h3 class="text-white font-display-xl {% if col_span == '8' %}text-headline-lg{% else %}text-headline-md{% endif %} mb-2">
              {{ block.settings.title }}
            </h3>
            <p class="text-white/80 font-body-md {% if col_span == '8' %}max-w-sm{% else %}max-w-xs{% endif %} leading-relaxed">
              {{ block.settings.description }}
            </p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Premium Commercial Bento",
  "settings": [
    {
      "type": "header",
      "content": "Section Aesthetics"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f7f3eb"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Sector Specific Engineering"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
