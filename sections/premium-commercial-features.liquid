        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Bulk Sizing Support"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Custom widths up to 12m for expansive airport and mall entrances."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Support & Quote",
      "blocks": [
