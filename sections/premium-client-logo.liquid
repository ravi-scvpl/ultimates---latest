{%- style -%}
  #premium-client-logo-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: 'transparent' }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  
  .premium-marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
  }

  .premium-marquee-content {
    display: flex;
    width: max-content;
    animation: premium-scroll-left {{ section.settings.speed | default: 30 }}s linear infinite;
    gap: 48px;
    align-items: center;
  }

  .premium-marquee-content:hover {
    {% if section.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  @keyframes premium-scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
{%- endstyle -%}

<section id="premium-client-logo-{{ section.id }}" class="relative w-full z-10 overflow-hidden font-body-md text-on-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop text-center">
    
    {% if section.settings.heading != blank %}
      <h2 class="font-display-xl text-3xl md:text-5xl text-primary font-normal mb-8 md:mb-12">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="premium-marquee-wrapper py-4">
      <div class="premium-marquee-content">
        {% for i in (1..2) %}
          {% for block in section.blocks %}
            {% if block.settings.logo_image != blank %}
              <div class="flex-shrink-0 flex items-center justify-center px-4" {{ block.shopify_attributes }}>
                <img 
                  src="{{ block.settings.logo_image | image_url: width: 240 }}" 
                  alt="Featured Client Logo"
                  class="h-12 md:h-16 w-auto object-contain opacity-75 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300"
                  loading="lazy"
                >
              </div>
            {% else %}
              <div class="flex-shrink-0 flex items-center justify-center w-24 h-12 bg-surface-container-high rounded text-xs text-on-surface-variant px-4">
                Client
              </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Premium Client Logos",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED CLIENTS"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Marquee Animation Speed",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause scrolling on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Client Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Client Logos",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
