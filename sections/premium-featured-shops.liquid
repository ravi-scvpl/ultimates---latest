{% comment %}
  Premium Featured Shops (Application Categories) Section
{% endcomment %}

{%- style -%}
  #premium-featured-shops-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color | default: '#ffffff' }};
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="premium-featured-shops-{{ section.id }}" class="relative w-full z-10 font-body-md text-on-surface overflow-hidden">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop text-center">
    
    <!-- Section Header -->
    {% if section.settings.subheading != blank %}
      <p class="font-label-caps uppercase text-secondary text-xs font-bold mb-4 tracking-[0.2em] select-none">
        {{ section.settings.subheading }}
      </p>
    {% endif %}
    
    {% if section.settings.title != blank %}
      <h2 class="font-display-xl text-3xl md:text-5xl font-normal leading-tight text-primary mb-12">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    <!-- Circular Categories Grid/Flex -->
    <div class="flex flex-wrap justify-center items-start gap-x-6 gap-y-10 md:gap-x-10 lg:gap-x-12 max-w-6xl mx-auto">
      {% for block in section.blocks %}
        {%- liquid
          assign item_title = block.settings.slide_title
          assign item_link = block.settings.link
          assign item_image = block.settings.image

          if block.settings.product != blank
            assign prod = block.settings.product
            if item_title == blank
              assign item_title = prod.title
            endif
            if item_link == blank
              assign item_link = prod.url
            endif
            if item_image == blank
              assign item_image = prod.featured_image
            endif
          elsif block.settings.page != blank
            assign pg = block.settings.page
            if item_title == blank
              assign item_title = pg.title
            endif
            if item_link == blank
              assign item_link = pg.url
            endif
          endif
        -%}
        <div class="flex flex-col items-center w-[130px] md:w-[150px] text-center group" {{ block.shopify_attributes }}>
          
          {%- if item_link != blank -%}
            <a href="{{ item_link }}" class="block w-full">
          {%- endif -%}
            
            <!-- Circular image wrapper -->
            <div class="relative w-24 h-24 md:w-32 md:h-32 rounded-full overflow-hidden bg-surface-container-high transition-transform duration-300 ease-out group-hover:scale-105 group-hover:shadow-md mx-auto">
              {% if item_image != blank %}
                <img 
                  src="{{ item_image | image_url: width: 300 }}" 
                  alt="{{ item_title | escape }}"
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                  width="150"
                  height="150"
                >
              {% else %}
                <div class="w-full h-full flex items-center justify-center text-on-surface-variant/40">
                  <span class="material-symbols-outlined text-4xl">image</span>
                </div>
              {% endif %}
            </div>
            
            <!-- Category Title -->
            <h3 class="mt-4 md:mt-5 text-xs md:text-sm font-semibold tracking-wider text-primary uppercase group-hover:text-secondary transition-colors duration-300 leading-snug font-label-caps">
              {{ item_title }}
            </h3>

          {%- if item_link != blank -%}
            </a>
          {%- endif -%}
          
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Premium Featured Shops",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "SHOP BY APPLICATION"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "shop_category",
      "name": "Shop Category",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product (Dynamic Image/Link)"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page (Dynamic Title/Link)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image Override"
        },
        {
          "type": "text",
          "id": "slide_title",
          "label": "Category Title Override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link Override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Featured Shops",
      "blocks": [
        {
          "type": "shop_category"
        }
      ]
    }
  ]
}
{% endschema %}
