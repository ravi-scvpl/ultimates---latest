<!-- Premium Commercial Project Enquiry Form -->
<section
  id="premium-commercial-enquiry-{{ section.id }}"
  class="px-margin-mobile md:px-margin-desktop py-20 md:py-28 relative z-10"
  style="background-color: {{ section.settings.bg_color | default: '#e7e1de' }};"
>
  <div class="max-w-container-max mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
    <!-- Left Column: Context & Details -->
    <div class="space-y-8 text-left">
      {% if section.settings.heading != blank %}
        <h2 class="font-display-xl text-display-xl leading-tight text-primary">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      
      {% if section.settings.description != blank %}
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-md leading-relaxed">
          {{ section.settings.description }}
        </p>
      {% endif %}
      
      <div class="pt-8 border-t border-on-surface/10 space-y-4">
        {% if section.settings.email != blank %}
          <p class="flex items-center gap-3 text-body-md text-primary font-medium">
            <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 0, 'wght' 300;">mail</span> 
            <a href="mailto:{{ section.settings.email }}" class="hover:underline">{{ section.settings.email }}</a>
          </p>
        {% endif %}
        
        {% if section.settings.phone != blank %}
          <p class="flex items-center gap-3 text-body-md text-primary font-medium">
            <span class="material-symbols-outlined text-primary" style="font-variation-settings: 'FILL' 0, 'wght' 300;">call</span> 
            <a href="tel:{{ section.settings.phone | replace: ' ', '' }}" class="hover:underline">{{ section.settings.phone }}</a>
          </p>
        {% endif %}
      </div>
    </div>

    <!-- Right Column: Form -->
    <div class="bg-surface rounded-lg p-8 md:p-12 shadow-sm border border-on-surface/5 bg-[#fdf9f1] text-left">
      <form class="space-y-6" id="commercial-form-{{ section.id }}">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2 text-left flex flex-col">
            <label class="text-label-caps font-label-caps uppercase text-on-surface-variant font-semibold text-xs tracking-wider">
              Company Name
            </label>
            <input
              required
              class="w-full bg-[#fdf9f1] border-b border-outline-variant focus:border-primary px-0 py-3 outline-none transition-all text-primary font-body-md text-base"
              placeholder="Architecture Studio Ltd."
              type="text"
              name="company"
            />
          </div>
          <div class="space-y-2 text-left flex flex-col">
            <label class="text-label-caps font-label-caps uppercase text-on-surface-variant font-semibold text-xs tracking-wider">
              Project Type
            </label>
            <select
              class="w-full bg-[#fdf9f1] border-b border-outline-variant focus:border-primary px-0 py-3 outline-none transition-all text-primary font-body-md text-base appearance-none cursor-pointer"
              name="project_type"
            >
              <option>Hospitality / Hotel</option>
              <option>Commercial Office</option>
              <option>Retail / Shopping Center</option>
              <option>Education / Healthcare</option>
              <option>Other</option>
            </select>
          </div>
        </div>
        
        <div class="space-y-2 text-left flex flex-col">
          <label class="text-label-caps font-label-caps uppercase text-on-surface-variant font-semibold text-xs tracking-wider">
            Approx Quantity (m²)
          </label>
          <input
            required
            class="w-full bg-[#fdf9f1] border-b border-outline-variant focus:border-primary px-0 py-3 outline-none transition-all text-primary font-body-md text-base"
            placeholder="e.g. 150"
            type="number"
            name="quantity"
          />
        </div>
        
        <div class="space-y-2 text-left flex flex-col">
          <label class="text-label-caps font-label-caps uppercase text-on-surface-variant font-semibold text-xs tracking-wider">
            Project Details
          </label>
          <textarea
            required
            class="w-full bg-[#fdf9f1] border-b border-outline-variant focus:border-primary px-0 py-3 outline-none transition-all resize-none text-primary font-body-md text-base"
            placeholder="Describe your flooring requirements..."
            rows="4"
            name="details"
          ></textarea>
        </div>
        
        <button
          class="w-full bg-primary text-on-primary py-4 rounded-full font-label-md text-label-md hover:opacity-90 transition-all uppercase tracking-widest mt-4 bg-black text-white hover:bg-black/90 font-semibold"
          type="submit"
        >
          Submit Enquiry
        </button>
      </form>
    </div>
  </div>
</section>

<!-- Submitting micro-interaction scoped to section -->
<script>
  (function() {
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('commercial-form-{{ section.id }}');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const btn = form.querySelector('button');
          const originalText = btn.innerText;
          
          btn.innerText = 'ENQUIRY SENT';
          btn.style.backgroundColor = '#79573e'; // Theme secondary brown color
          btn.style.color = '#ffffff';
          
          setTimeout(() => {
            btn.innerText = originalText;
            btn.style.backgroundColor = ''; // Restore default class bg-black
            btn.style.color = '';
            form.reset();
          }, 3000);
        });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Premium Project Enquiry",
  "settings": [
    {
      "type": "header",
      "content": "Section Aesthetics"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#e7e1de"
    },
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Project Consultation"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Section Description",
      "default": "Connect with our commercial team for technical specifications, bulk pricing, and custom project quotes."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Consulting Email",
      "default": "commercial@ultimats.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Consulting Telephone",
      "default": "+44 (0) 20 7946 0123"
    }
  ],
  "presets": [
    {
      "name": "Premium Project Enquiry"
    }
  ]
}
{% endschema %}
