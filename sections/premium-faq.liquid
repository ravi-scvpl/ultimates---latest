<!-- Premium FAQ Section / Expert Guidance -->
{% style %}
  #premium-faq-{{ section.id }} .glass-card {
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(25, 23, 21, 0.1);
  }
{% endstyle %}

<section
  id="premium-faq-{{ section.id }}"
  class="bg-white py-20 md:py-28 relative z-10"
  style="background-color: {{ section.settings.bg_color | default: '#ffffff' }};"
>
  <div class="px-margin-mobile md:px-margin-desktop max-w-3xl mx-auto w-full">
    <!-- Section Heading -->
    {% if section.settings.heading != blank %}
      <h2 class="font-headline-lg text-headline-lg mb-12 text-center text-primary">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <!-- Accordion Stack -->
    <div class="space-y-4 text-left">
      {% for block in section.blocks %}
        {% if block.settings.question != blank and block.settings.answer != blank %}
          <details
            class="group glass-card overflow-hidden transition-all duration-300 [&_summary::-webkit-details-marker]:hidden"
            {{ block.shopify_attributes }}
            {% if block.settings.open_by_default %}
              open
            {% endif %}
          >
            <summary class="flex justify-between items-center p-6 cursor-pointer hover:bg-surface-container transition-colors list-none select-none">
              <span class="font-headline-md text-xl text-primary leading-snug">
                {{ block.settings.question }}
              </span>
              <span class="material-symbols-outlined group-open:rotate-180 transition-transform text-primary text-2xl flex-shrink-0">
                expand_more
              </span>
            </summary>
            <div class="p-6 pt-0 text-on-surface-variant font-body-md border-t border-on-surface/5 mt-4 leading-relaxed text-sm md:text-base">
              {{ block.settings.answer | newline_to_br }}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Premium Expert FAQ",
  "settings": [
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Expert Guidance"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Frequently Asked Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Provide a detailed and helpful response to address your customers' common inquiries."
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by Default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Expert FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I order a custom size?",
            "answer": "Yes. Most of our barrier mat ranges can be manufactured to your specific dimensions. We offer a \"Made to Measure\" service where you can specify width and length to the millimeter for a perfect architectural fit.",
            "open_by_default": true
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I clean my barrier mat?",
            "answer": "Regular maintenance involves daily vacuuming to remove dry soil. For deeper cleans, our mats are compatible with injection-extraction cleaning systems. For smaller sizes, many are machine washable up to 30°C.",
            "open_by_default": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is the expected lifespan?",
            "answer": "Our commercial-grade barrier mats are engineered for longevity. In high-traffic environments like hotel lobbies, you can expect 5-7 years of peak performance with proper maintenance. Residential usage often exceeds 10 years.",
            "open_by_default": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
