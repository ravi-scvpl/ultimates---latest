{% comment %}
  Premium Testimonials Section for Shopify Premium Hero page layout
{% endcomment %}

{%- style -%}
  #premium-testimonials-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color | default: '#fdf9f1' }};
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="premium-testimonials-{{ section.id }}" class="relative w-full z-10 font-body-md text-on-surface overflow-hidden">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop relative">
    
    <!-- Section Header -->
    {% if section.settings.heading != blank %}
      <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
        <h2 class="font-display-xl text-4xl lg:text-6xl font-normal leading-tight text-primary mb-4">
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <!-- Carousel Container -->
    <div class="relative flex items-center w-full">
      <!-- Left Arrow -->
      <button class="premium-carousel-arrow premium-prev-arrow absolute -left-4 lg:-left-12 z-20 hidden sm:flex bg-white/40 hover:bg-white/70 border border-on-surface/10 w-12 h-12 rounded-full items-center justify-center transition-all duration-300 shadow-sm backdrop-blur-md cursor-pointer hover:scale-105" aria-label="Previous testimonials">
        <span class="material-symbols-outlined text-[20px] font-light">chevron_left</span>
      </button>
      
      <!-- Testimonials Carousel -->
      <div class="premium-testimonials-carousel flex overflow-x-auto scroll-smooth w-full gap-6 pb-6 scrollbar-none" style="scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;">
        {% for block in section.blocks %}
          <div class="premium-testimonial-card flex-shrink-0 w-[85%] sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)] glass-card p-8 md:p-10 rounded-lg flex flex-col justify-between transition-all duration-500 hover:scale-[1.01] hover:shadow-md" 
               style="scroll-snap-align: start;" 
               {{ block.shopify_attributes }}>
            
            <div class="flex flex-col">
              <!-- Star rating or quote mark -->
              <span class="material-symbols-outlined text-secondary text-4xl mb-6 font-light" style="font-variation-settings: 'FILL' 1, 'wght' 300;">format_quote</span>
              
              <div class="text-on-surface-variant italic font-normal text-base md:text-lg mb-8 leading-relaxed">
                "{{ block.settings.testimonial_text }}"
              </div>
            </div>
            
            <div class="border-t border-on-surface/5 pt-6 mt-auto">
              <div class="font-semibold text-secondary text-sm uppercase tracking-wider mb-1 font-label-caps">
                {{ block.settings.author_name }}
              </div>
              <div class="text-on-surface-variant/75 text-xs">
                {{ block.settings.author_title }}
              </div>
            </div>

          </div>
        {% endfor %}
      </div>
      
      <!-- Right Arrow -->
      <button class="premium-carousel-arrow premium-next-arrow absolute -right-4 lg:-right-12 z-20 hidden sm:flex bg-white/40 hover:bg-white/70 border border-on-surface/10 w-12 h-12 rounded-full items-center justify-center transition-all duration-300 shadow-sm backdrop-blur-md cursor-pointer hover:scale-105" aria-label="Next testimonials">
        <span class="material-symbols-outlined text-[20px] font-light">chevron_right</span>
      </button>
    </div>
    
    <!-- Dots Indicators -->
    <div class="premium-carousel-dots flex justify-center gap-3 mt-8">
      {% for block in section.blocks %}
        <button class="premium-carousel-dot w-2 h-2 rounded-full bg-on-surface/20 border-none p-0 cursor-pointer transition-all duration-300 {% if forloop.first %}bg-primary scale-125{% endif %}" 
                data-index="{{ forloop.index0 }}" 
                aria-label="Go to testimonial {{ forloop.index }}"></button>
      {% endfor %}
    </div>

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('premium-testimonials-{{ section.id }}');
  if (!container) return;
  
  const carousel = container.querySelector('.premium-testimonials-carousel');
  const cards = container.querySelectorAll('.premium-testimonial-card');
  const dots = container.querySelectorAll('.premium-carousel-dot');
  const prevArrow = container.querySelector('.premium-prev-arrow');
  const nextArrow = container.querySelector('.premium-next-arrow');
  
  if (!carousel || cards.length === 0) return;
  
  let currentIndex = 0;
  
  function updateCarousel() {
    const cardWidth = cards[0].offsetWidth + 24; // width + gap
    carousel.scrollTo({
      left: currentIndex * cardWidth,
      behavior: 'smooth'
    });
    
    dots.forEach((dot, index) => {
      if (index === currentIndex) {
        dot.classList.add('bg-primary', 'scale-125');
        dot.classList.remove('bg-on-surface/20');
      } else {
        dot.classList.remove('bg-primary', 'scale-125');
        dot.classList.add('bg-on-surface/20');
      }
    });
  }

  // Arrow controls
  if (prevArrow && nextArrow) {
    prevArrow.addEventListener('click', () => {
      currentIndex = Math.max(currentIndex - 1, 0);
      updateCarousel();
    });

    nextArrow.addEventListener('click', () => {
      // Calculate max index based on visible items
      let visibleCount = 1;
      if (window.innerWidth >= 1024) visibleCount = 3;
      else if (window.innerWidth >= 640) visibleCount = 2;
      
      const maxIndex = Math.max(cards.length - visibleCount, 0);
      currentIndex = Math.min(currentIndex + 1, maxIndex);
      updateCarousel();
    });
  }

  // Dot controls
  dots.forEach(dot => {
    dot.addEventListener('click', function() {
      currentIndex = parseInt(this.dataset.index);
      updateCarousel();
    });
  });

  // Responsive boundary reset on resize
  window.addEventListener('resize', () => {
    updateCarousel();
  });
});
</script>

{% schema %}
{
  "name": "Premium Testimonials",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf9f1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "testimonial_text",
          "label": "Testimonial",
          "default": "This is a sample testimonial from a happy customer."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "John Doe"
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "Author Title",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
