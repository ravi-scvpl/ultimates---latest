<style>
  #CatalogHero-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    box-sizing: border-box;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.section_height_desktop == 'adapt' %}
      min-height: auto;
    {% else %}
      min-height: {{ section.settings.section_height_desktop }};
    {% endif %}
  }

  .catalog-hero-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .catalog-hero-media img,
  .catalog-hero-media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .catalog-hero-media .desktop-image {
    display: block;
  }

  .catalog-hero-media .mobile-image {
    display: none;
  }

  .catalog-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  .catalog-hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px 20px;
    display: flex;
    box-sizing: border-box;
    {% case section.settings.content_position %}
      {% when 'top-left' %}
        align-items: flex-start;
        justify-content: flex-start;
      {% when 'top-center' %}
        align-items: flex-start;
        justify-content: center;
      {% when 'top-right' %}
        align-items: flex-start;
        justify-content: flex-end;
      {% when 'middle-left' %}
        align-items: center;
        justify-content: flex-start;
      {% when 'middle-center' %}
        align-items: center;
        justify-content: center;
      {% when 'middle-right' %}
        align-items: center;
        justify-content: flex-end;
      {% when 'bottom-left' %}
        align-items: flex-end;
        justify-content: flex-start;
      {% when 'bottom-center' %}
        align-items: flex-end;
        justify-content: center;
      {% when 'bottom-right' %}
        align-items: flex-end;
        justify-content: flex-end;
    {% endcase %}
  }

  .catalog-hero-content {
    max-width: {{ section.settings.content_width }}px;
    width: 100%;
    text-align: {{ section.settings.text_alignment }};
  }

  .catalog-hero-heading {
    margin: 0 0 16px 0;
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    font-family: var(--font-heading-family, inherit);
    line-height: 1.2;
    word-break: break-word;
  }

  .catalog-hero-description {
    margin: 0;
    font-size: {{ section.settings.description_size }}px;
    color: {{ section.settings.description_color }};
    line-height: 1.6;
  }

  .catalog-hero-description p {
    margin: 0 0 12px 0;
    color: inherit;
  }

  .catalog-hero-description p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    #CatalogHero-{{ section.id }} {
      {% if section.settings.section_height_mobile == 'adapt' %}
        min-height: auto;
      {% else %}
        min-height: {{ section.settings.section_height_mobile }};
      {% endif %}
    }

    {% if section.settings.mobile_image != blank %}
      .catalog-hero-media .desktop-image {
        display: none;
      }
      .catalog-hero-media .mobile-image {
        display: block;
      }
    {% endif %}

    .catalog-hero-content {
      text-align: {{ section.settings.mobile_text_alignment }};
    }

    .catalog-hero-heading {
      font-size: {{ section.settings.heading_size | times: 0.75 | round }}px;
    }

    .catalog-hero-description {
      font-size: {{ section.settings.description_size | times: 0.9 | round }}px;
    }
  }
</style>

<section class="catalog-hero-section" id="CatalogHero-{{ section.id }}">
  <div class="catalog-hero-media">
    {% if section.settings.image != blank %}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.heading | escape }}"
        loading="lazy"
        class="desktop-image"
      >
      {% if section.settings.mobile_image != blank %}
        <img
          src="{{ section.settings.mobile_image | image_url: width: 1000 }}"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          class="mobile-image"
        >
      {% else %}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          alt="{{ section.settings.heading | escape }}"
          loading="lazy"
          class="mobile-image"
        >
      {% endif %}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  <div class="catalog-hero-overlay"></div>

  <div class="catalog-hero-container">
    <div class="catalog-hero-content">
      {% if section.settings.heading != blank %}
        <h1 class="catalog-hero-heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="catalog-hero-description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Catalog Hero Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image (100% Width)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image (Optional)"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Section Height & Layout"
    },
    {
      "type": "select",
      "id": "section_height_desktop",
      "label": "Desktop Height",
      "default": "600px",
      "options": [
        { "value": "100vh", "label": "Full Screen (100vh)" },
        { "value": "800px", "label": "Extra Large (800px)" },
        { "value": "600px", "label": "Large (600px)" },
        { "value": "500px", "label": "Medium (500px)" },
        { "value": "400px", "label": "Small (400px)" },
        { "value": "adapt", "label": "Adapt to Image Height" }
      ]
    },
    {
      "type": "select",
      "id": "section_height_mobile",
      "label": "Mobile Height",
      "default": "400px",
      "options": [
        { "value": "100vh", "label": "Full Screen (100vh)" },
        { "value": "500px", "label": "Large (500px)" },
        { "value": "400px", "label": "Medium (400px)" },
        { "value": "300px", "label": "Small (300px)" },
        { "value": "adapt", "label": "Adapt to Image Height" }
      ]
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Content Box Max Width",
      "default": 800
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content Position",
      "default": "middle-center",
      "options": [
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-center", "label": "Top Center" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "middle-left", "label": "Middle Left" },
        { "value": "middle-center", "label": "Middle Center" },
        { "value": "middle-right", "label": "Middle Right" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-center", "label": "Bottom Center" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Mobile Text Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "CATALOG COLLECTION"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Description Settings"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore our premium range of commercial and residential entrance mats designed for superior performance and elegance.</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Catalog Hero Banner",
      "settings": {
        "heading": "CATALOG COLLECTION",
        "description": "<p>Explore our premium range of commercial and residential entrance mats designed for superior performance and elegance.</p>"
      }
    }
  ]
}
{% endschema %}
