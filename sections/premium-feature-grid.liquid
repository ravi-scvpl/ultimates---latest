{%- style -%}
  #premium-feature-grid-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color | default: '#fdf9f1' }};
    background-color: var(--bg-color);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="premium-feature-grid-{{ section.id }}" class="relative w-full z-10 font-body-md text-on-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    
    <!-- Section Header -->
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="text-center max-w-3xl mx-auto mb-12 lg:mb-16">
        {% if section.settings.heading != blank %}
          <h2 class="font-display-xl text-4xl lg:text-6xl font-normal leading-tight text-primary mb-4">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="text-on-surface-variant font-body-lg text-base lg:text-lg leading-relaxed">
            {{ section.settings.subheading }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Grid Layout -->
    {% if section.blocks.size > 0 %}
      {% if section.blocks.size <= 2 %}
        <div class="grid grid-cols-1 md:grid-cols-{{ section.blocks.size }} gap-6">
          {% for block in section.blocks %}
            <div class="relative overflow-hidden rounded-lg aspect-video group transition-all duration-500 hover:scale-[1.02] hover:shadow-lg" {{ block.shopify_attributes }}>
              <!-- Media -->
              <div class="absolute inset-0 w-full h-full">
                {% if block.settings.video_url != blank %}
                  <video class="w-full h-full object-cover" autoplay loop muted playsinline>
                    {% if block.settings.video_url contains '//' %}
                      <source src="{{ block.settings.video_url }}" type="video/mp4">
                    {% else %}
                      <source src="{{ block.settings.video_url | asset_url }}" type="video/mp4">
                    {% endif %}
                  </video>
                {% elsif block.settings.video != blank %}
                  {{ block.settings.video | video_tag: class: 'w-full h-full object-cover', autoplay: true, loop: true, muted: true, playsinline: true }}
                {% elsif block.settings.image != blank %}
                  <img class="w-full h-full object-cover" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.title | escape }}">
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover bg-surface-container-high' }}
                {% endif %}
              </div>
              
              <!-- Subtle dark gradient overlay at the bottom (always visible on mobile, hover on desktop) -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent pointer-events-none z-10 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-300"></div>

              <!-- Text content overlay (always visible on mobile, hover transform on desktop) -->
              <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6 z-20 flex flex-col justify-end text-left text-white lg:opacity-0 lg:group-hover:opacity-100 lg:transform lg:translate-y-4 lg:group-hover:translate-y-0 transition-all duration-300 bg-gradient-to-t from-black/70 to-transparent lg:bg-none pt-12">
                {% if block.settings.title != blank %}
                  <h3 class="font-headline-md text-base sm:text-lg text-white font-medium mb-1.5">
                    {{ block.settings.title }}
                  </h3>
                {% endif %}
                {% if block.settings.text != blank %}
                  <p class="text-white/90 font-body-md text-xs sm:text-sm leading-relaxed">
                    {{ block.settings.text }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
          
          <!-- Left Column (Main Card) -->
          <div class="lg:col-span-5 flex flex-col h-full">
            {% assign first_block = section.blocks[0] %}
            <div class="relative overflow-hidden rounded-lg aspect-square lg:aspect-auto lg:h-full lg:flex-1 group transition-all duration-500 hover:scale-[1.01] hover:shadow-lg" {{ first_block.shopify_attributes }}>
              <!-- Media -->
              <div class="absolute inset-0 w-full h-full">
                {% if first_block.settings.video_url != blank %}
                  <video class="w-full h-full object-cover" autoplay loop muted playsinline>
                    {% if first_block.settings.video_url contains '//' %}
                      <source src="{{ first_block.settings.video_url }}" type="video/mp4">
                    {% else %}
                      <source src="{{ first_block.settings.video_url | asset_url }}" type="video/mp4">
                    {% endif %}
                  </video>
                {% elsif first_block.settings.video != blank %}
                  {{ first_block.settings.video | video_tag: class: 'w-full h-full object-cover', autoplay: true, loop: true, muted: true, playsinline: true }}
                {% elsif first_block.settings.image != blank %}
                  <img class="w-full h-full object-cover" src="{{ first_block.settings.image | image_url: width: 1200 }}" alt="{{ first_block.settings.title | escape }}">
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover bg-surface-container-high' }}
                {% endif %}
              </div>
              
              <!-- Subtle dark gradient overlay at the bottom -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none z-10"></div>

              <!-- Text content overlay -->
              <div class="absolute inset-x-0 bottom-0 p-6 z-20 flex flex-col justify-end text-left text-white bg-gradient-to-t from-black/80 to-transparent pt-12">
                {% if first_block.settings.title != blank %}
                  <h3 class="font-headline-md text-xl lg:text-2xl font-normal leading-tight text-white mb-2">
                    {{ first_block.settings.title }}
                  </h3>
                {% endif %}
                {% if first_block.settings.text != blank %}
                  <p class="text-white/80 font-body-md text-sm lg:text-base leading-relaxed">
                    {{ first_block.settings.text }}
                  </p>
                {% endif %}
              </div>
            </div>
          </div>

          <!-- Right Column (Small Cards Grid) -->
          <div class="lg:col-span-7 grid gap-6 {% if section.blocks.size == 3 %}grid-cols-1{% else %}grid-cols-1 sm:grid-cols-2{% endif %}">
            {% for block in section.blocks offset: 1 %}
              <div class="relative overflow-hidden rounded-lg aspect-[4/3] group transition-all duration-500 hover:scale-[1.02] hover:shadow-lg" {{ block.shopify_attributes }}>
                <!-- Media -->
                <div class="absolute inset-0 w-full h-full">
                  {% if block.settings.video_url != blank %}
                    <video class="w-full h-full object-cover" autoplay loop muted playsinline>
                      {% if block.settings.video_url contains '//' %}
                        <source src="{{ block.settings.video_url }}" type="video/mp4">
                      {% else %}
                        <source src="{{ block.settings.video_url | asset_url }}" type="video/mp4">
                      {% endif %}
                    </video>
                  {% elsif block.settings.video != blank %}
                    {{ block.settings.video | video_tag: class: 'w-full h-full object-cover', autoplay: true, loop: true, muted: true, playsinline: true }}
                  {% elsif block.settings.image != blank %}
                    <img class="w-full h-full object-cover" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}">
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover bg-surface-container-high' }}
                  {% endif %}
                </div>

                <!-- Subtle dark gradient overlay at the bottom (always visible on mobile, hover on desktop) -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent pointer-events-none z-10 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-300"></div>

                <!-- Text content overlay (always visible on mobile, hover transform on desktop) -->
                <div class="absolute inset-x-0 bottom-0 p-5 sm:p-6 z-20 flex flex-col justify-end text-left text-white lg:opacity-0 lg:group-hover:opacity-100 lg:transform lg:translate-y-4 lg:group-hover:translate-y-0 transition-all duration-300 bg-gradient-to-t from-black/70 to-transparent lg:bg-none pt-12">
                  {% if block.settings.title != blank %}
                    <h3 class="font-headline-md text-base sm:text-lg text-white font-medium mb-1.5">
                      {{ block.settings.title }}
                    </h3>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="text-white/90 font-body-md text-xs sm:text-sm leading-relaxed">
                      {{ block.settings.text }}
                    </p>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>

        </div>
      {% endif %}
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Premium Feature Grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf9f1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "ULTISCRAPE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Outdoor Floor Mat for Aggressive Scraping of Dirt"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "media_card",
      "name": "Media Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Card Video (Shopify Library)"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Card Video URL (Direct link to MP4)",
          "info": "Useful for external URLs or Shopify CDN direct links."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Card Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Card Description",
          "default": "Add feature description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Feature Grid",
      "blocks": [
        {
          "type": "media_card"
        },
        {
          "type": "media_card"
        },
        {
          "type": "media_card"
        },
        {
          "type": "media_card"
        },
        {
          "type": "media_card"
        }
      ]
    }
  ]
}
{% endschema %}
