<!-- Premium Footer Section -->
<footer id="premium-footer-{{ section.id }}" class="w-full pt-20 pb-12 bg-surface-container border-t border-on-surface/10 relative z-10" style="background-color: #f1ede6; border-top: 1px solid rgba(28, 28, 23, 0.1);">
  <!-- Desktop Footer Layout (Hidden on Mobile) -->
  <div class="hidden md:grid grid-cols-5 gap-8 px-margin-desktop max-w-container-max mx-auto w-full">
    
    <!-- Branding Column -->
    <div class="md:col-span-1 flex flex-col gap-6">
      <div class="font-display-xl text-headline-md text-primary tracking-tighter">{{ section.settings.brand_name | default: 'ULTIMATS' }}</div>
      <p class="text-on-surface-variant font-body-md max-w-xs leading-relaxed">
        {{ section.settings.brand_description | default: 'Redefining architectural thresholds with precision engineering and premium materials.' }}
      </p>
      
      <!-- Social Icons -->
      <div class="flex gap-4">
        {% if section.settings.twitter_url != blank %}
          <a class="w-10 h-10 flex items-center justify-center rounded-full border border-on-surface/10 hover:bg-primary hover:text-white transition-all duration-300" href="{{ section.settings.twitter_url }}" target="_blank" aria-label="Twitter">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"></path>
            </svg>
          </a>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <a class="w-10 h-10 flex items-center justify-center rounded-full border border-on-surface/10 hover:bg-primary hover:text-white transition-all duration-300" href="{{ section.settings.instagram_url }}" target="_blank" aria-label="Instagram">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Column 2: Menu 1 -->
    <div class="space-y-4">
      <h4 class="font-label-caps text-label-caps text-primary">{{ section.settings.menu_title_1 | default: 'Products' }}</h4>
      <ul class="space-y-2 text-on-surface-variant font-body-md">
        {% assign footer_menu_1 = section.settings.menu_1 %}
        {% if footer_menu_1 != blank and linklists[footer_menu_1].links.size > 0 %}
          {% for link in linklists[footer_menu_1].links %}
            <li>
              <a class="hover:underline underline-offset-4 transition-all duration-300" href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        {% else %}
          <!-- Fallback links mimicking spec -->
          <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/collections/all">Barrier Mats</a></li>
          <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/collections/all">Aluminium</a></li>
          <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/collections/all">Carpet</a></li>
          <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/pages/corporate-resellers">Bulk Order</a></li>
        {% endif %}
      </ul>
    </div>

    <!-- Column 3: Associate With Us -->
    <div class="space-y-4">
      <h4 class="font-label-caps text-label-caps text-primary">{{ section.settings.menu_title_2 | default: 'Associate With Us' }}</h4>
      <ul class="space-y-2 text-on-surface-variant font-body-md">
        <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/pages/distribution-import">Distribution & Import</a></li>
        <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/pages/rental-mats">Rental Mats</a></li>
        <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/pages/architects-designers">Architects & Designers</a></li>
        <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/pages/corporate-resellers">Corporate Resellers</a></li>
        <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/pages/careers">Careers</a></li>
      </ul>
    </div>

    <!-- Column 4: Menu 3 & Copyright -->
    <div class="space-y-4">
      <h4 class="font-label-caps text-label-caps text-primary">{{ section.settings.menu_title_3 | default: 'Company' }}</h4>
      <ul class="space-y-2 text-on-surface-variant font-body-md">
        {% assign footer_menu_3 = section.settings.menu_3 %}
        {% if footer_menu_3 != blank and linklists[footer_menu_3].links.size > 0 %}
          {% for link in linklists[footer_menu_3].links %}
            <li>
              <a class="hover:underline underline-offset-4 transition-all duration-300" href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        {% else %}
          <!-- Fallback links mimicking spec -->
          <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/pages/about-us">About</a></li>
          <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/pages/contact">Contact</a></li>
        {% endif %}
      </ul>
    </div>

    <!-- Column 5: POLICIES -->
    <div class="space-y-4">
      <h4 class="font-label-caps text-label-caps text-primary uppercase">POLICIES</h4>
      <ul class="space-y-2 text-on-surface-variant font-sans text-xs uppercase tracking-wider">
        <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/policies/terms-of-service">Terms of Service</a></li>
        <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/policies/privacy-policy">Privacy Policy</a></li>
        <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/policies/refund-policy">Returns Policy</a></li>
        <li><a class="hover:underline underline-offset-4 transition-all duration-300" href="/policies/shipping-policy">Shipping Policy</a></li>
      </ul>
    </div>

  </div>

  <!-- Desktop Bottom Footer Bar -->
  <div class="hidden md:flex justify-between items-center text-xs text-on-surface-variant/70 px-margin-desktop max-w-container-max mx-auto w-full mt-16 pt-8 border-t border-on-surface/10">
    <div></div>
    <p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'Ultimats. Architectural Entrance Solutions.' }}</p>
  </div>

  <!-- Mobile Footer Layout (Visible ONLY on Mobile, matching mobile-home.html footer) -->
  <div class="block md:hidden px-margin-mobile">
    <div class="mb-12">
      <span class="font-display-xl text-headline-md text-primary block mb-6">{{ section.settings.brand_name | default: 'ULTIMATS' }}</span>
      <p class="font-body-md text-on-surface-variant text-sm leading-relaxed">
        {{ section.settings.brand_description | default: 'High-performance architectural entrance systems. Crafted for endurance and elegance.' }}
      </p>
    </div>

    <div class="grid grid-cols-2 gap-y-10 gap-x-4 mb-16">
      <!-- Products Column -->
      <div>
        <h4 class="font-label-caps text-label-caps text-primary mb-4 uppercase">{{ section.settings.menu_title_1 | default: 'Products' }}</h4>
        <ul class="space-y-3 font-body-md text-body-md text-on-surface-variant">
          {% assign footer_menu_1 = section.settings.menu_1 %}
          {% if footer_menu_1 != blank and linklists[footer_menu_1].links.size > 0 %}
            {% for link in linklists[footer_menu_1].links %}
              <li><a class="hover:underline" href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a class="hover:underline" href="/collections/all">Barrier Mats</a></li>
            <li><a class="hover:underline" href="/collections/all">Aluminium</a></li>
            <li><a class="hover:underline" href="/collections/all">Carpet</a></li>
            <li><a class="hover:underline" href="/pages/corporate-resellers">Bulk</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Associate With Us Column -->
      <div>
        <h4 class="font-label-caps text-label-caps text-primary mb-4 uppercase">{{ section.settings.menu_title_2 | default: 'Associate With Us' }}</h4>
        <ul class="space-y-3 font-body-md text-body-md text-on-surface-variant">
          <li><a class="hover:underline" href="/pages/distribution-import">Distribution & Import</a></li>
          <li><a class="hover:underline" href="/pages/rental-mats">Rental Mats</a></li>
          <li><a class="hover:underline" href="/pages/architects-designers">Architects & Designers</a></li>
          <li><a class="hover:underline" href="/pages/corporate-resellers">Corporate Resellers</a></li>
          <li><a class="hover:underline" href="/pages/careers">Careers</a></li>
        </ul>
      </div>

      <!-- Company Column -->
      <div>
        <h4 class="font-label-caps text-label-caps text-primary mb-4 uppercase">{{ section.settings.menu_title_3 | default: 'Company' }}</h4>
        <ul class="space-y-3 font-body-md text-body-md text-on-surface-variant">
          {% assign footer_menu_3 = section.settings.menu_3 %}
          {% if footer_menu_3 != blank and linklists[footer_menu_3].links.size > 0 %}
            {% for link in linklists[footer_menu_3].links %}
              <li><a class="hover:underline" href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a class="hover:underline" href="/pages/about-us">About</a></li>
            <li><a class="hover:underline" href="/pages/contact">Contact</a></li>
            <li><a class="hover:underline" href="/policies/shipping-policy">Shipping</a></li>
            <li><a class="hover:underline" href="/pages/architects-designers">Architects</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Policies Column -->
      <div class="col-span-2 mt-4">
        <h4 class="font-label-caps text-label-caps text-primary mb-4 uppercase">POLICIES</h4>
        <ul class="space-y-3 font-sans text-xs uppercase tracking-wider text-on-surface-variant">
          <li><a class="hover:underline" href="/policies/terms-of-service">Terms of Service</a></li>
          <li><a class="hover:underline" href="/policies/privacy-policy">Privacy Policy</a></li>
          <li><a class="hover:underline" href="/policies/refund-policy">Returns Policy</a></li>
          <li><a class="hover:underline" href="/policies/shipping-policy">Shipping Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- Socials & Copyright bottom area -->
    <div class="flex flex-col gap-6 pt-10 border-t border-on-surface/10">
      <div class="flex gap-4">
        {% if section.settings.twitter_url != blank %}
          <a class="w-10 h-10 flex items-center justify-center rounded-full border border-on-surface/10 hover:bg-primary hover:text-white transition-all duration-300" href="{{ section.settings.twitter_url }}" target="_blank" aria-label="Twitter">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"></path>
            </svg>
          </a>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <a class="w-10 h-10 flex items-center justify-center rounded-full border border-on-surface/10 hover:bg-primary hover:text-white transition-all duration-300" href="{{ section.settings.instagram_url }}" target="_blank" aria-label="Instagram">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
            </svg>
          </a>
        {% endif %}
      </div>
      <p class="font-body-md text-xs text-on-surface-variant/70 italic">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'Ultimats. Architectural Entrance Solutions.' }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Premium Brand Footer",
  "settings": [
    {
      "type": "header",
      "content": "Branding Column"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "ULTIMATS"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand Description",
      "default": "Redefining architectural thresholds with precision engineering and premium materials."
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "text",
      "id": "twitter_url",
      "label": "Twitter URL",
      "default": "#"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "#"
    },
    {
      "type": "header",
      "content": "Navigation Menus Override",
      "info": "Leave blank to display default premium static links"
    },
    {
      "type": "text",
      "id": "menu_title_1",
      "label": "Menu 1 Header",
      "default": "Products"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1 Linklist"
    },
    {
      "type": "text",
      "id": "menu_title_2",
      "label": "Menu 2 Header",
      "default": "Associate With Us"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2 Linklist"
    },
    {
      "type": "text",
      "id": "menu_title_3",
      "label": "Menu 3 Header",
      "default": "Company"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu 3 Linklist"
    },
    {
      "type": "header",
      "content": "Copyright Footer"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Ultimats. Architectural Entrance Solutions."
    }
  ]
}
{% endschema %}
