{%- style -%}
  #premium-about-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#fdf9f1' }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="premium-about-{{ section.id }}" class="relative w-full z-10 font-body-md text-on-surface">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    
    <!-- Page Title / Hero -->
    {% if section.settings.show_header %}
      <div class="text-left max-w-4xl mb-20">
        <p class="font-label-caps text-label-caps uppercase text-on-surface-variant mb-4">Our Heritage & Future</p>
        <h1 class="font-display-xl text-display-xl-mobile md:text-display-xl leading-none mb-6 text-primary" style="font-family: 'Playfair Display', serif;">
          {{ section.settings.title | default: page.title }}
        </h1>
        {% if section.settings.intro_heading != blank %}
          <p class="text-xl md:text-2xl text-secondary italic font-light max-w-2xl leading-relaxed mb-8" style="font-family: 'Playfair Display', serif;">
            {{ section.settings.intro_heading }}
          </p>
        {% endif %}
        <div class="h-1 w-24 bg-primary"></div>
      </div>
    {% endif %}

    <!-- Section 1: About Us (Image Left, Text Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center mb-24 lg:mb-32">
      <div class="lg:col-span-5 relative">
        <div class="aspect-[4/5] rounded-lg overflow-hidden border border-outline-variant/30 custom-shadow bg-surface-container-high">
          {% if section.settings.about_image != blank %}
            <img 
              src="{{ section.settings.about_image | image_url: width: 1000 }}" 
              alt="About Ultimats" 
              class="w-full h-full object-cover hover:scale-102 transition-transform duration-700"
              loading="lazy"
            >
          {% else %}
            <img 
              src="{{ 'sara.png' | asset_url }}" 
              alt="About Ultimats" 
              class="w-full h-full object-cover hover:scale-102 transition-transform duration-700"
              loading="lazy"
            >
          {% endif %}
        </div>
      </div>
      <div class="lg:col-span-7 text-left space-y-6">
        <h2 class="font-display-xl text-3xl lg:text-5xl font-normal text-primary leading-tight" style="font-family: 'Playfair Display', serif;">
          {{ section.settings.about_heading | default: "Crafting Spaces" }}
        </h2>
        <div class="h-[2px] w-12 bg-secondary"></div>
        <div class="font-body-lg text-on-surface-variant leading-relaxed space-y-6 text-sm lg:text-base">
          {{ section.settings.about_text }}
        </div>
      </div>
    </div>

    <!-- Section 2: Mission Statement Banner -->
    {% if section.settings.mission_quote != blank %}
      <div class="my-24 lg:my-32 relative overflow-hidden rounded-lg bg-surface-container/30 border border-outline-variant/30 custom-shadow p-8 md:p-16 text-center">
        <div class="absolute -top-10 -left-10 text-9xl text-on-surface/5 font-serif select-none" style="font-size: 15rem;">“</div>
        <div class="relative max-w-4xl mx-auto space-y-6">
          <span class="material-symbols-outlined text-secondary text-5xl">insights</span>
          <h3 class="font-headline-lg text-2xl lg:text-4xl font-normal leading-snug text-primary italic" style="font-family: 'Playfair Display', serif;">
            "{{ section.settings.mission_quote }}"
          </h3>
          {% if section.settings.mission_heading != blank %}
            <p class="font-label-caps text-label-caps uppercase text-secondary tracking-widest font-semibold mt-4">
              — {{ section.settings.mission_heading }}
            </p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <!-- Section 3: CSR Initiative (Text Left, Image Right) -->
    {% if section.settings.show_csr_section %}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        <div class="lg:col-span-7 text-left space-y-6 order-2 lg:order-1">
          <h2 class="font-display-xl text-3xl lg:text-5xl font-normal text-primary leading-tight" style="font-family: 'Playfair Display', serif;">
            {{ section.settings.csr_heading | default: "Social Responsibility" }}
          </h2>
          <div class="h-[2px] w-12 bg-secondary"></div>
          <div class="font-body-lg text-on-surface-variant leading-relaxed space-y-6 text-sm lg:text-base">
            {{ section.settings.csr_text }}
          </div>
        </div>
        <div class="lg:col-span-5 relative order-1 lg:order-2">
          <div class="aspect-[4/5] rounded-lg overflow-hidden border border-outline-variant/30 custom-shadow bg-surface-container-high">
            {% if section.settings.csr_image != blank %}
              <img 
                src="{{ section.settings.csr_image | image_url: width: 1000 }}" 
                alt="CSR Initiative" 
                class="w-full h-full object-cover hover:scale-102 transition-transform duration-700"
                loading="lazy"
              >
            {% else %}
              <img 
                src="{{ 'buster.png' | asset_url }}" 
                alt="CSR Initiative" 
                class="w-full h-full object-cover hover:scale-102 transition-transform duration-700"
                loading="lazy"
              >
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Premium About Us",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf9f1"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show Section Page Header",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Page Title"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Introduction Tagline"
    },
    {
      "type": "header",
      "content": "About Block"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "About Heading"
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "About Description"
    },
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "About Image"
    },
    {
      "type": "header",
      "content": "Mission Block"
    },
    {
      "type": "text",
      "id": "mission_heading",
      "label": "Mission Author/Label"
    },
    {
      "type": "textarea",
      "id": "mission_quote",
      "label": "Mission Quote"
    },
    {
      "type": "image_picker",
      "id": "mission_image",
      "label": "Mission Background Image"
    },
    {
      "type": "header",
      "content": "CSR Block"
    },
    {
      "type": "text",
      "id": "csr_heading",
      "label": "CSR Heading"
    },
    {
      "type": "richtext",
      "id": "csr_text",
      "label": "CSR Description"
    },
    {
      "type": "image_picker",
      "id": "csr_image",
      "label": "CSR Image"
    },
    {
      "type": "checkbox",
      "id": "show_csr_section",
      "label": "Show CSR / Section 3",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ]
}
{% endschema %}
