      "label": "Card Title Color",
      "default": "#14110d"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Description Color",
      "default": "#5b5751"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Card Icons Color",
      "default": "#79573e",
      "info": "Applies when Google Material Icons are displayed"
    },
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Section Eyebrow",
      "default": "Built for the door"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Engineered for Performance"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "The science of keeping your space pristine starts at the door."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Performance Card",
      "settings": [
        {
          "type": "text",
