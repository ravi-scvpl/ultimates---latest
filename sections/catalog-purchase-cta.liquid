      "label": "Card 2 Description",
      "default": "Customize to your exact size, recessed mat well specs, or custom architectural layouts."
    },
    {
      "type": "product",
      "id": "card2_product",
      "label": "Select Product (Optional)"
    },
    {
      "type": "url",
      "id": "card2_url",
      "label": "Custom URL (Fallback if no product selected)"
    },
    {
      "type": "text",
      "id": "card2_btn_label",
      "label": "Button Label",
      "default": "Customize To Your Exact Size"
